        function appendToSelect(selectId, text, value) {
            const $dropdown = $(selectId); 
            $dropdown.append(new Option(text, value, true, true)).trigger('change');
        }
         
        function openModal(type) {
            currentEntityType = type;
            const config = entityConfig[type];

            modalTitle.innerHTML = config.title;
            lblItemName.textContent = config.label;
            txtItemName.placeholder = config.placeholder;
            txtItemName.value = '';
            txtItemName.classList.remove('is-invalid');
             
            $("#btnSaveModal").prop("disabled", false);

            itemModal.show();
        }
         
