        async function loadDropdown(apiUrl, ddlId, valueField, textField, defaultText) {
            try {
               // alert(token);
                const response = await fetch(apiUrl, {
                    method: "GET",
                    headers: {
                        "Authorization": token ? `Bearer ${token}` : ""
                    }
                });
                // alert(token);
                if (!response.ok)
                    throw new Error("Failed to Load : " + apiUrl);

                const data = await response.json();

                let html = `<option value="">${defaultText}</option>`;

                data.forEach(item => {
                    html += `<option value="${item[valueField]}">${item[textField]}</option>`;
                });

                $(ddlId).html(html);
            }
            catch (error) {
                console.error(error);
            }
        }

