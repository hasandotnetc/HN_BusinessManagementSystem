                    companyName: comp?.name  || "My Company",
                    websiteLink: comp?.websiteLink  || "https://example.com"
                };
            } catch (err) {
                console.error("Error fetching company information:", err);
                return { companyName: "Company Name", websiteLink: "https://example.com" };
            }
        }

