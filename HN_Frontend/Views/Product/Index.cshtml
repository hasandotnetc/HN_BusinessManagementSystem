        function LoadProducts() {
            $.ajax({ 
                url:`${APP_CONFIG.API_BASE_URL}api/SearchingByDapper/GetProductByPaginationRequest`,
                type: "GET", 
                data: { 
                    Page: currentPage, 
                    PageSize: pageSize, 
                    Search: ($("#txtSearch").val() || "").trim()
                },
                success: function (res) {
                    console.log(res);
                    BindTable(res.data);
                    totalPages = res.totalPages;
                    CreatePagination();
                    $("#paginationInfo").html(
                        `Showing ${((currentPage-1)*pageSize)+1}
                         -
                         ${Math.min(currentPage*pageSize,res.totalRecords)}
                         of
                         ${res.totalRecords}
                         Products`
                    );
                }             
            });
