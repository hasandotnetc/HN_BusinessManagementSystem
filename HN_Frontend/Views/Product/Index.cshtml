@{
    ViewData["Title"] = "Product Setup";
}

<!-- ================= REBECCAPURPLE PERFECT INLINE LAYOUT ================= -->

 <style>
    :root {
        /* Primary Brand Palette */
        --rebecca-solid: #663399;           /* RebeccaPurple */
        --rebecca-dark: #4b2375;            /* Darker Purple Hover */
        --rebecca-gold: #e0aa3e;            /* Action Accent Gold */
        --rebecca-gold-hover: #cc962d;      /* Accent Gold Hover */
        --rebecca-light-bg: #f3f4f6;        /* Soft Dashboard Page Background */
        --rebecca-card-bg: #ffffff;         /* Premium White Container Surface */
        --rebecca-border: #e5e7eb;          /* Subtle Light Dividers */
        
        /* Typography Colors */
        --text-dark: #1f2937;               /* Crisp Dark Text */
        --text-muted: #6b7280;              /* Secondary Label Text */
        --text-purple: #663399;             /* Highlight Labels */
    }

    /* Base Layout Container */
    .product-workspace-wrapper {
        background-color: var(--rebecca-light-bg);
        color: var(--text-dark);
        border-radius: 8px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Premium White Cards */
    .form-card-premium {
        background-color: var(--rebecca-card-bg) !important;
        border: 1px solid var(--rebecca-border);
        border-radius: 8px;
        padding: 16px !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
    }

    /* Solid Purple Header Bar */
    .section-header-banner {
        background-color: var(--rebecca-solid);
        color: #ffffff;
        padding: 8px 14px;
        border-radius: 6px;
        margin-bottom: 16px;
    }

    .section-title-White {
        color: #ffffff;
        font-weight: 600; 
        font-size: 14px;
        letter-spacing: 0.5px;
    }

    /* Labels & Input Controls */
    .inline-label {
        color: #374151;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        min-width: 95px;
        display: flex;
        align-items: center;
    }

    .custom-form-control {
        background-color: #ffffff !important;
        color: var(--text-dark) !important;
        border: 1px solid #d1d5db !important;
        border-radius: 4px !important;
        padding: 4px 8px;
        font-size: 12px;
        height: 28px !important;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .custom-form-control:focus {
        border-color: var(--rebecca-solid) !important;
        box-shadow: 0 0 0 2px rgba(102, 51, 153, 0.2) !important;
    }

    /* Indicators & Checkboxes */
    .per-text-indicator {
        font-size: 11px;
        color: var(--text-muted);
        white-space: nowrap;
        font-weight: 500;
    }

    .row-aligned-checkbox {
        width: 15px;
        height: 15px;
        cursor: pointer;
        accent-color: var(--rebecca-solid);
    }

    /* Primary & Utility Buttons */
    .btn-gold-action {
        background-color: var(--rebecca-gold);
        color: #1a0f30 !important;
        font-weight: 700;
        border: none;
        padding: 5px 20px;
        border-radius: 4px;
        font-size: 12px;
        transition: background-color 0.2s ease;
    }

    .btn-gold-action:hover {
        background-color: var(--rebecca-gold-hover);
    }

    .btn-purple-utility {
        background-color: var(--rebecca-solid);
        color: #ffffff !important;
        border: none;
        border-radius: 4px;
        padding: 2px 12px;
        font-size: 11px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease;
    }

    .btn-purple-utility:hover {
        background-color: var(--rebecca-dark);
    }

    .btn-purple-outline {
        background-color: #ffffff;
        color: var(--rebecca-solid) !important;
        border: 1px solid var(--rebecca-solid);
        border-radius: 4px;
        padding: 2px 12px;
        font-size: 11px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .btn-purple-outline:hover {
        background-color: #f3e8ff;
    }

    /* File Uploader Box */
    .uploader-box {
        border: 2px dashed #d1d5db;
        background-color: #fafafa;
        border-radius: 6px;
        cursor: pointer;
        height: 125px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .uploader-box:hover {
        border-color: var(--rebecca-solid);
        background-color: #f3e8ff;
    }

    /* Table & Container Styling */
    .premium-table-container {
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--rebecca-border);
        min-height: 220px;
        font-size: 12px;
        background-color: #ffffff;
    }

    .premium-data-table th {
        background-color: var(--rebecca-solid) !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 12px;
        padding: 8px 10px !important;
        border: none !important;
    }

    .premium-data-table td {
        background-color: transparent !important;
        color: var(--text-dark) !important;
        border-bottom: 1px solid var(--rebecca-border) !important;
        padding: 8px 10px !important;
    }

    .premium-data-table tbody tr:hover {
        background-color: #fafafa !important;
    }

    .mandatory-star {
        color: #dc2626;
        margin-left: 2px;
    }

    /* Action Buttons in Table */
    .btn-action-edit {
        background-color: var(--rebecca-gold);
        color: #1a0f30;
        font-weight: 600;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        border: none;
    }

    .btn-action-edit:hover {
        background-color: var(--rebecca-gold-hover);
    }



     
    /* ================== Modal-POP Up CSS Style  ======================*/

    /* Blurred background effect for modals */
    .modal-backdrop.show {
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        background-color: rgba(15, 23, 42, 0.4);
    }

    /* Shared utility button styling */
    .btn-purple-utility {
        background-color: rebeccapurple;
        color: #fff;
        border: none;
        transition: background-color 0.2s ease-in-out;
    }

        .btn-purple-utility:hover {
            background-color: #53287d;
            color: #fff;
        }

    /* Modal and Form Inputs */
    .modal-content {
        border-radius: 12px;
        overflow: hidden;
    }

    .custom-input,
    .custom-form-control {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        transition: all 0.2s ease-in-out;
    }

        .custom-input:focus,
        .custom-form-control:focus {
            border-color: rebeccapurple;
            box-shadow: 0 0 0 0.25rem rgba(102, 51, 153, 0.25);
        }

    .mandatory-star {
        color: #dc3545;
    }

    .inline-label {
        min-width: 90px;
        font-weight: 600;
    }



</style>
 

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
@* <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script> *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>

<div class="container-fluid p-2 product-workspace-wrapper my-0">

    <!-- ================= ROW 1: PRODUCT FORM SECTION ================= -->
    <div class="form-card-premium mb-3">
     
        <div class="section-header-banner d-flex align-items-center">
            <i class="fa-solid fa-square-poll-horizontal text-warning me-2" style="font-size: 13px;"></i>
            <h2 class="section-title-White m-0 text-uppercase tracking-wider">Product Information</h2>
        </div>
        <form id="productForm" onsubmit="handleFormSubmit(event)" novalidate>
            <div class="row g-3 align-items-start">

                <!-- COLUMN 1: Basic Input Fields + Inline Serial Product -->
                <div class="col-xl-3 col-md-6">
                    <!-- Product Name -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="txtProductName">Product Name<span class="mandatory-star">*</span></label>
                        <div class="w-100">
                            <input type="text" id="txtProductName" class="form-control custom-form-control" placeholder="Enter product name" maxlength="500">
                            <div id="errProductName" class="text-danger d-none" style="font-size:10px; position:absolute;">Required</div>
                        </div>
                    </div>

                       <!-- Code No -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="txtProductCode">Code No</label>
                        <input type="text" id="txtProductCode" class="form-control custom-form-control" readonly disabled>
                    </div>


                    <!-- Model No -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="txtModelNo">Model No <span class="mandatory-star">*</span></label>
                        <input type="text" id="txtModelNo" class="form-control custom-form-control" placeholder="Enter model number">
                    </div>
                    <!-- -->

                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">
                            Unit of Type  <span class="mandatory-star">*</span>
                        </label>
                        <div class="d-flex gap-1 w-100">
                            <select id="ddlProductUnitType" class="form-select custom-form-control"></select>
                           @*  <button id="btnAddNewGroup" type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button> *@
                        </div>
                    </div>
                        
                </div>
                 
                <div class="col-xl-3 col-md-6">
                    
                    <!-- VAT Row -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" id="lblVat" for="numVat">Vat ($)</label>
                        <div class="d-flex align-items-center gap-2 w-100">
                            <input type="number" id="numVat" class="form-control custom-form-control w-100" placeholder="0.00" step="0.01">
                            <span class="per-text-indicator">Per(%)</span>
                            <input type="checkbox" id="chkVatMode" onchange="toggleInputMode('Vat')" class="row-aligned-checkbox">
                        </div>
                    </div>
                     
                    <!-- Warranty Row -->
                    <div class="d-flex align-items-center mb-0">
                        <label class="inline-label" for="txtWarranty">Warranty </label>
                        <input type="number" id="txtWarranty" class="form-control custom-form-control w-100" placeholder="Months e.g. 6 ">
                    </div>
             
                    <!-- Serial Product: Transformed into perfect row matching layout -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="chkSerialProduct">Serial Product</label>
                        <div class="d-flex align-items-center" style="height: 28px;">
                            <input type="checkbox" id="chkSerialProduct" class="row-aligned-checkbox">
                        </div>
                    </div>

                    <!-- Serial Product: Transformed into perfect row matching layout -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="chkActiveStatus">Active Status</label>
                        <div class="d-flex align-items-center" style="height: 28px;">
                            <input type="checkbox" id="chkActiveStatus" class="row-aligned-checkbox">
                        </div>
                    </div>

                </div>

                <!-- COLUMN 3: Product Picture Upload Area -->
                <div class="col-xl-2 col-md-4">
                    <div class="uploader-box">
                        <input type="file" id="fileProductPicture" class="position-absolute w-100 h-100 top-0 start-0 opacity-0" style="cursor: pointer;" accept="image/*">
                        
                        <div id="uploadPlaceholder" class="text-center p-1">
                            <i class="fa-solid fa-cloud-arrow-up text-purple mb-1" style="font-size:16px; color: #663399;"></i>
                            <div class="fw-bold text-dark" style="font-size:11px;">Click to upload image</div>
                            <div style="font-size: 9px;" class="text-muted">PNG, JPG up to 5MB</div>
                        </div>
                        <img id="imgPreview" class="w-100 h-100 object-fit-contain d-none rounded" alt="Preview">
                    </div>
                     
                </div>

                <!-- COLUMN 4: Dropdowns Selector Fields -->
                 
                <div class="col-xl-4 col-md-8">

                    <!-- GROUP -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">
                            Group <span class="mandatory-star">*</span>
                        </label>
                        <div class="d-flex gap-1 w-100">
                            <select id="ddlGroup" class="form-select custom-form-control"></select>
                            <button id="btnAddNewGroup" type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>
                        </div>
                    </div>

                    <!-- CATEGORY -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">
                            Category <span class="mandatory-star">*</span>
                        </label>
                        <div class="d-flex gap-1 w-100">
                            <select id="ddlCategory" class="form-select custom-form-control"></select>
                            <button id="btnAddNewCategory" type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>
                        </div>
                    </div>

                    <!-- BRAND -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">
                            Brand <span class="mandatory-star">*</span>
                        </label>
                        <div class="d-flex gap-1 w-100">
                            <select id="ddlBrand" class="form-select custom-form-control"></select>
                            <button id="btnAddNewBrand" type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>
                        </div>
                    </div>


                    <!-- -->
                    <div class="d-flex align-items-center">
                        <label class="inline-label">
                            Product Type <span class="mandatory-star">*</span>
                        </label>

                        <select id="ddlProductType" class="form-select custom-form-control">
                            <option value="">-- Select Product Type --</option>
                            <option value="Inventory">Inventory</option>
                            <option value="Service">Service (Purchase are not allow)</option>
                        </select>
                    </div>

                </div>


                <div class="col-xl-8 col-md-6">
                    <!-- Product Note -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="txtProductNote">Remarks/Note </label>
                        <div class="w-100">
                            <input type="text" id="txtProductNote" class="form-control custom-form-control" placeholder="Enter product remarks or notes" maxlength="500">
                            @* <div id="errProductName" class="text-danger d-none" style="font-size:10px; position:absolute;">Required</div> *@
                        </div>
                    </div> 
                </div> 

                <!-- REUSABLE MODAL -->
                <div class="modal fade custom-blur-modal" id="modalAddNewItem" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg">

                            <div class="modal-header text-white" style="background-color: rebeccapurple;">
                                <h5 class="modal-title fw-bold" id="modalItemTitle">
                                    <i class="fa-solid fa-folder-plus me-2"></i>Add Item
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body p-4">
                                <form id="formAddItem" onsubmit="return false;">
                                    <div class="mb-3">
                                        <label id="lblItemName" for="txtItemName" class="form-label fw-semibold" style="color: #333;">Item Name</label>
                                        <input type="text" id="txtItemName" class="form-control custom-input" placeholder="Enter name..." autocomplete="off">
                                        <div class="invalid-feedback">Name cannot be empty.</div>
                                    </div>
                                </form>
                            </div>

                            <div class="modal-footer bg-light border-0">
                                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>

                                <!-- DYNAMIC SAVE BUTTON WITH DEDICATED ID HANDLERS -->
                                <button type="button" id="btnSaveModal" class="btn text-white px-4 fw-semibold" style="background-color: rebeccapurple;">
                                    <i class="fa-solid fa-check me-1"></i>Save
                                </button>
                            </div>

                        </div>
                    </div>
                </div>




            </div>
             



            <!-- Form Action Footer -->
            <div class="d-flex justify-content-between align-items-center pt-2 mt-3 border-top flex-wrap gap-2">

                <!-- Code Generation Options (Visible after Save or in Edit mode) -->
                <div id="codeGeneratorSection" class="d-none d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-1">
                        <label class="inline-label mb-0" style="min-width: auto; font-size: 11px;">Paper Size:</label>
                        <select id="ddlPaperSize" class="form-select custom-form-control" style="width: 250px; height: 28px;" onchange="handlePaperSizeChange()">
                            <option value="50x25">Standard Sticker (50mm x 25mm)</option>
                            <option value="38x25">Small Label (38mm x 25mm)</option>
                            <option value="100x50">Shipping Tag (100mm x 50mm)</option>
                            <option value="A4">A4 Sheet (Multi-Label)</option>
                        </select>
                    </div>

                    <!-- A4 Customization Options -->
                    <div id="a4OptionsSection" class="d-none d-flex align-items-center gap-2">
                        <input type="number" id="numA4Count" class="form-control custom-form-control" style="width: 70px;" placeholder="Count" value="24" min="1">
                        <select id="ddlA4LabelSize" class="form-select custom-form-control" style="width: auto;">
                            <option value="A4_24">3x8 Layout (24 Labels/Page)</option>
                            <option value="A4_40">4x10 Layout (40 Labels/Page)</option>
                            <option value="A4_12">2x6 Layout (12 Labels/Page)</option>
                        </select>
                    </div>

                    <button type="button" class="btn btn-purple-utility gap-1" onclick="generateCode('BARCODE')">
                        <i class="fa-solid fa-barcode"></i> Barcode
                    </button>
                    <button type="button" class="btn btn-purple-utility gap-1" onclick="generateCode('QRCODE')">
                        <i class="fa-solid fa-qrcode"></i> QR Code
                    </button>
                </div>

                <!-- Main Action Buttons -->
                <div class="d-flex justify-content-end gap-2 ms-auto">
                    <input type="hidden" id="txtProductId" value="0" />

                    <button type="button" onclick="resetForm()" class="btn btn-purple-outline h-auto py-1 px-3">
                        <i class="fa-solid fa-rotate-left me-1"></i> Reset
                    </button>

                    <button id="btnSave" type="submit" class="btn btn-gold-action">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Product
                    </button>

                    <button id="btnUpdate" type="button" class="btn btn-gold-action d-none">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Product
                    </button>
                </div>
            </div>
             
             
        </form>
    </div>

    <!-- ================= ROW 2: PRODUCT LIST CONTAINER ================= -->
    <div class="form-card-premium">

        <div class="section-header-banner d-flex align-items-center justify-content-between mb-0">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-list-ul text-warning me-2" style="font-size:13px;"></i>
                <h3 class="section-title-White m-0 text-uppercase tracking-wider" style="font-size:14px;">Product List</h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group" style="max-width: 300px; height: 26px;">
                    <input type="text" id="txtSearch" class="form-control bg-white text-dark text-xs py-0" placeholder="Search product, brand, group..." style="height:26px; font-size:11px;">
                    <button class="btn btn-purple-utility px-2 py-0" type="button" style="height:26px;"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
                <div class="d-flex align-items-center gap-1" style="font-size:11px;">
                    <span class="text-white-50">Show</span>
                    <select id="ddlPageSize" class="form-select bg-white text-dark py-0 px-1" style="width: auto; font-size:11px; height:26px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                    </select>
                </div>
                <button type="button" class="btn btn-gold-action py-0 px-3" style="font-size:11px; height:26px;">Add</button>
            </div>
        </div>

         
        <div class="table-responsive premium-table-container position-relative">
            <table class="table premium-data-table align-middle m-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Code No</th> 
                        <th>Model No</th>
                        <th>Group</th>
                        <th>Category</th>
                        <th>Brand</th> 
                        <th>Unit Type</th>
                        <th>Active</th>

                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="productTableBody"></tbody>
            </table>


            <div class="d-flex justify-content-between align-items-center mt-2">

                <div id="paginationInfo"
                     class="text-white-50"
                     style="font-size:12px;">
                    Showing 0-0 of 0 Products
                </div>

                <nav>
                    <ul id="pagination"
                        class="pagination pagination-sm mb-0">
                    </ul>
                </nav>

            </div>

            <div id="emptyStatePlaceholder" class="text-center py-5 m-0">
                <i class="fa-solid fa-box-open text-warning mb-2" style="font-size:24px;"></i>
                <div class="text-white fw-bold" style="font-size:13px;">No Registered Products Found</div>
                <p class="text-white-50 m-0" style="font-size:11px;">Your workspace inventory repository database runtime is currently empty.</p>
            </div>
        </div>
    </div>
     
     
    <div class="modal fade custom-blur-modal" id="modalAddNewGroup" tabindex="-1" aria-labelledby="modalAddNewGroupLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">

                <!-- Header -->
                <div class="modal-header text-white" style="background-color: rebeccapurple;">
                    <h5 class="modal-title fw-bold" id="modalAddNewGroupLabel">
                        <i class="fa-solid fa-folder-plus me-2"></i>Add New Product Group
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-4">
                    <form id="formAddGroup">
                        <div class="mb-3">
                            <label for="txtProductGroupName" class="form-label fw-semibold" style="color: #333;">Product Group Name</label>
                            <input type="text" id="txtProductGroupName" class="form-control custom-input" placeholder="e.g., Beverages, Electronics" required autocomplete="off">
                        </div>
                    </form>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveGroup" class="btn text-white px-4 fw-semibold" style="background-color: rebeccapurple;">
