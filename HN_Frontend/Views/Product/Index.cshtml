                formData.append("ProductImage", file);
            }
            formData.forEach((value, key) => {
                console.log(key, ":", value);
            });
            // return;
            $.ajax({
                url: "https://localhost:7008/api/Product/SaveProduct",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,

                success: function (res) {
                    alert("Saved Successfully");
                    console.log(res);
                },

                error: function (err) {
                    console.error(err);
                    alert("Failed to save product.");
                }
            });
