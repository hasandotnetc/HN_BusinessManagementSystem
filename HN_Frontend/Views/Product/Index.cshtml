        function resetForm() {
            document.getElementById('productForm').reset();
            imgPreview.src = "";
            imgPreview.classList.add('d-none');
            uploadPlaceholder.classList.remove('d-none');
            ['Discount', 'Vat', 'Tax'].forEach(mode => toggleInputMode(mode));
        }



        function calculateCalculatedValue(type, price) { 
            let value = 0;
            let isPercent = false; 
            switch (type) {
                case "Discount":
                    value = parseFloat($("#numDiscount").val()) || 0;
                    isPercent = $("#chkDiscountMode").prop("checked");
                    break;

                case "Vat":
                    value = parseFloat($("#numVat").val()) || 0;
                    isPercent = $("#chkVatMode").prop("checked");
                    break;

                case "Tax":
                    value = parseFloat($("#numTax").val()) || 0;
                    isPercent = $("#chkTaxMode").prop("checked");
                    break;
            }

            if (isPercent) {
                return (price * value) / 100;
            }

            return value;
        }


        const API_BASE_URL = "https://localhost:7008/api/Product";
        const IMAGE_BASE_URL = "https://localhost:7008/";

        const DEFAULT_IMAGE = `${IMAGE_BASE_URL}/Upload/Product/no-image.png`;
        console.log(DEFAULT_IMAGE);


        $(document).ready(function () {

            loadMasterDropdowns();

        });

        async function loadMasterDropdowns() {
            // alert("je;;p");
            try {

                await Promise.all([

                    loadDropdown(
                        `${API_BASE_URL}/AllProductGroupList`,
                        "#ddlGroup",
                        "productGroupId",
                        "name",
                        "--Select Group--"
                    ),

                    loadDropdown(
                        `${API_BASE_URL}/AllProductCategoryList`,
                        "#ddlCategory",
                        "categoryId",
                        "name",
                        "--Select Category--"
                    ),

                    loadDropdown(
                        `${API_BASE_URL}/AllProductBrandList`,
                        "#ddlBrand",
                        "brandId",
                        "name",
                        "--Select Brand--"
                    )

                ]);


            }
            catch (error) {

                console.error(error);

            }

        }

        async function loadDropdown(apiUrl, ddlId, valueField, textField, defaultText) {

            try {

                const response = await fetch(apiUrl);

                if (!response.ok)
                    throw new Error("Failed to Load : " + apiUrl);

                const data = await response.json();

                let html = `<option value="">${defaultText}</option>`;

                data.forEach(item => {

                    html += `
                        <option value="${item[valueField]}">
                            ${item[textField]}
                        </option>
                    `;

                });

                $(ddlId).html(html);

            }
            catch (error) {

                console.error(error);

            }

        }
        let currentPage = 1;
        let pageSize = 10;
        let totalPages = 0;

        $(document).ready(function () {
            LoadProducts();
        });

        function LoadProducts() {
            $.ajax({
                url: "https://localhost:7008/api/SearchingByDapper/GetProductByPaginationRequest", 
                type: "GET", 
                data: { 
                    Page: currentPage, 
                    PageSize: pageSize, 
                    Search: ($("#txtSearch").val() || "").trim()
                },
                success: function (res) {
                    console.log(res);
                    BindTable(res.data);
                    totalPages = res.totalPages;
                    CreatePagination();
                    $("#paginationInfo").html(
                        `Showing ${((currentPage-1)*pageSize)+1}
                         -
                         ${Math.min(currentPage*pageSize,res.totalRecords)}
                         of
                         ${res.totalRecords}
                         Products`
                    );
                }             
            });
        }

                function BindTable(data) {
            let html = "";
            if (data.length == 0) {
                $("#productTableBody").html("");
                $("#emptyStatePlaceholder").show();
                return;
            }
            $("#emptyStatePlaceholder").hide();
            $.each(data, function(index, item) {
                html += `
                    <tr>
                        <td class="fw-semibold">${((currentPage - 1) * pageSize) + (index + 1)}</td>
                        <td>
                            <img src="${getImageUrl(item.imageUrl)}"
                                 width="40"
                                 height="40"
                                 class="rounded border"
                                 style="object-fit: cover;"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='${DEFAULT_IMAGE}'">
                        </td>
                        <td class="fw-semibold text-dark">${item.productName}</td>
                        <td>${item.model || '-'}</td>
                        <td>${item.groupName || '-'}</td>
                        <td>${item.categoryName || '-'}</td>
                        <td>${item.brandName || '-'}</td>
                        <td class="fw-bold text-dark">${item.price}</td>
                        <td><span class="badge bg-light text-dark border">${item.stockType || 'Standard'}</span></td>
                        <td class="text-center">
                            <button class="btn btn-action-edit">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                            </button>
                        </td>
                    </tr>
                `;
            });
            $("#productTableBody").html(html);
        }

        function CreatePagination() {

            let html = "";

            html += `
        <li class="page-item ${currentPage==1?'disabled':''}">

        <a class="page-link"
        href="#"
        onclick="GoPage(${currentPage-1})">

        Previous

        </a>

        </li>
        `;

            for(let i=1;i<=totalPages;i++){

                html+=`
        <li class="page-item ${currentPage==i?'active':''}">

        <a class="page-link"

        href="#"

        onclick="GoPage(${i})">

        ${i}

        </a>

        </li>
        `;

            }

            html+=`
        <li class="page-item ${currentPage==totalPages?'disabled':''}">

        <a class="page-link"

        href="#"

        onclick="GoPage(${currentPage+1})">

        Next

        </a>

        </li>
        `;

            $("#pagination").html(html);

        }


        function GoPage(page){

            if(page<1)
                return;

            if(page>totalPages)
                return;

            currentPage=page;

            LoadProducts();

        }


        $("#txtSearch").keyup(function(){

            currentPage=1;

            LoadProducts();

        });

        $("#ddlPageSize").change(function(){

            pageSize=parseInt($(this).val());

            currentPage=1;

            LoadProducts();

        });
         
        function getImageUrl(path) {
            console.log('getImageUrl');
            console.log(path);
            if (!path || path.trim() === "")
                return DEFAULT_IMAGE;
            console.log(DEFAULT_IMAGE);

            return IMAGE_BASE_URL + path;
        }

         

          document.addEventListener('DOMContentLoaded', function () {
          const modalEl = document.getElementById('modalAddNewItem');
          const itemModal = new bootstrap.Modal(modalEl);

          const modalTitle = document.getElementById('modalItemTitle');
          const lblItemName = document.getElementById('lblItemName');
          const txtItemName = document.getElementById('txtItemName');
          const btnSaveModal = document.getElementById('btnSaveModal');

          // Track active entity type ('group' | 'category' | 'brand')
          let currentEntityType = ''; 
          const entityConfig = {
            group: {
              title: '<i class="fa-solid fa-layer-group me-2"></i>Add New Product Group',
              label: 'Product Group Name',
              placeholder: 'e.g., Beverages, Electronics',
              selectId: '#ddlGroup',
              apiUrl: 'https://localhost:7008/api/Product/SaveProductGroup'
            },
            category: {
              title: '<i class="fa-solid fa-tags me-2"></i>Add New Category',
              label: 'Category Name',
              placeholder: 'e.g., Cold Drinks, Smartphones',
              selectId: '#ddlCategory',
              apiUrl: 'https://localhost:7008/api/Product/SaveProductCategory'
            },
            brand: {
              title: '<i class="fa-solid fa-copyright me-2"></i>Add New Brand',
              label: 'Brand Name',
              placeholder: 'e.g., Coca-Cola, Apple',
              selectId: '#ddlBrand',
              apiUrl: 'https://localhost:7008/api/Product/SaveProductBrand'
            }
          };

          // Open modal configuration
          function openModal(type) {
            currentEntityType = type;
            const config = entityConfig[type];

            modalTitle.innerHTML = config.title;
            lblItemName.textContent = config.label;
            txtItemName.placeholder = config.placeholder;
            txtItemName.value = '';
            txtItemName.classList.remove('is-invalid');

            itemModal.show();
          }

          // Open modal button events
          document.getElementById('btnAddNewGroup').addEventListener('click', () => openModal('group'));
          document.getElementById('btnAddNewCategory').addEventListener('click', () => openModal('category'));
          document.getElementById('btnAddNewBrand').addEventListener('click', () => openModal('brand'));

          // Auto-focus field after opening modal
          modalEl.addEventListener('shown.bs.modal', function () {
            txtItemName.focus();
          });

          // Save button dispatcher
          btnSaveModal.addEventListener('click', function () {
            const itemName = txtItemName.value.trim();

            if (!itemName) {
              txtItemName.classList.add('is-invalid');
              txtItemName.focus();
              return;
            }

            txtItemName.classList.remove('is-invalid');

            // Route execution to specific AJAX API function
            if (currentEntityType === 'group') {
              saveGroupAPI(itemName);
            } else if (currentEntityType === 'category') {
              saveCategoryAPI(itemName);
            } else if (currentEntityType === 'brand') {
              saveBrandAPI(itemName);
            }
            $("#btnSaveModal").prop("disabled",true);
          });

          // ==========================================
          // 1. SEPARATE GROUP API CALL
          // ==========================================
          function saveGroupAPI(groupName) {
            const config = entityConfig.group;
            console.log(config);
            $.ajax({
              url: config.apiUrl,
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({ Name: groupName }),
              success: function (response) {
                // Append new item into #ddlGroup dropdown
                const id = response.id || groupName;
                $(config.selectId).append(new Option(groupName, id, true, true));

                itemModal.hide();
              },
              error: function (xhr, status, error) {
                alert('Error saving Product Group: ' + error);
              }
            });
          }

          // ==========================================
          // 2. SEPARATE CATEGORY API CALL
          // ==========================================
          function saveCategoryAPI(categoryName) {
            const config = entityConfig.category;

            $.ajax({
              url: config.apiUrl,
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({ Name: categoryName }),
              success: function (response) {
                // Append new item into #ddlCategory dropdown
                const id = response.id || categoryName;
                $(config.selectId).append(new Option(categoryName, id, true, true));

                itemModal.hide();
              },
              error: function (xhr, status, error) {
                alert('Error saving Category: ' + error);
              }
            });
          }

          // ==========================================
          // 3. SEPARATE BRAND API CALL
          // ==========================================
          function saveBrandAPI(brandName) {
            const config = entityConfig.brand;

            $.ajax({
              url: config.apiUrl,
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({ Name: brandName }),
              success: function (response) {
                // Append new item into #ddlBrand dropdown
                const id = response.id || brandName;
                $(config.selectId).append(new Option(brandName, id, true, true));

                itemModal.hide();
              },
              error: function (xhr, status, error) {
                alert('Error saving Brand: ' + error);
              }
            });
          }

        });





    </script>
}