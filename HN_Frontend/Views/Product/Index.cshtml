@section Scripts {
    <script>
        const imgInput = document.getElementById('fileProductPicture');
        const imgPreview = document.getElementById('imgPreview');
        const uploadPlaceholder = document.getElementById('uploadPlaceholder');
        const token = getAuthCookie("HN_JWT");


        const notyf = new Notyf({
            duration: 3000,
            position: { x: 'right', y: 'top' },
            dismissible: true
        });

        $(document).ready(function() { 
            imgInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                        imgPreview.classList.remove('d-none');
                        uploadPlaceholder.classList.add('d-none');
                    }
                    reader.readAsDataURL(file);
                }
            });
        });
         
        function toggleInputMode(fieldName) {
            const isChecked = document.getElementById(`chk${fieldName}Mode`).checked;
            const label = document.getElementById(`lbl${fieldName}`);
             
            if (isChecked) {
                label.innerText = `${fieldName} (%)`;
            } else {
                label.innerText = `${fieldName} ($)`;
            }
        }

        function calculateCalculatedValue(fieldName, mainPrice) {
            const inputVal = parseFloat(document.getElementById(`num${fieldName}`).value) || 0;
            const isPercent = document.getElementById(`chk${fieldName}Mode`).checked;
            return isPercent ? (mainPrice * inputVal) / 100 : inputVal;
        }



                     $("#codeGeneratorSection").removeClass("d-none");


            $("#btnSave").click(function (e) {
            e.preventDefault();

            // Prevent saving if product code already exists on the page
            const existingCode = $("#txtProductCode").val()?.trim();
            if (existingCode) {
                notyf.open({ type: 'warning', message: `Product already saved (${existingCode})` }); 
                return;
            }

            // 1. Validation for mandatory HTML fields
            const productName = $("#txtProductName").val().trim();
            const modelNo = $("#txtModelNo").val().trim();
            const unitType = $("#ddlProductUnitType").val();
            const groupVal = $("#ddlGroup").val();
            const categoryVal = $("#ddlCategory").val();
            const brandVal = $("#ddlBrand").val();
            const productType = $("#ddlProductType").val();

            if (!productName || !modelNo || !unitType || !groupVal || !categoryVal || !brandVal || !productType) {
                toastr.error("Please fill in all mandatory fields (*).", "Validation Error");
                return;
            }

            // 2. Build FormData Object
            var formData = new FormData();
            formData.append("Name", productName);
            formData.append("Model", modelNo);
            formData.append("UnitTypeId", unitType);
            formData.append("ProductType", productType);
            formData.append("Note", $("#txtProductNote").val());

            const vatValue = parseFloat($("#numVat").val()) || 0;
            const vatMode = $("#chkVatMode").is(":checked") ? "P" : "A";
            formData.append("VAT", vatValue);
            formData.append("VatMode", vatMode);

            formData.append("Warranty", parseFloat($("#txtWarranty").val()) || 0);
            formData.append("SerialAvailable", $("#chkSerialProduct").is(":checked") ? "Y" : "N");
            formData.append("IsActive", $("#chkActiveStatus").is(":checked") ? "Y" : "N"); 

            formData.append("GroupId", groupVal);
            formData.append("CategoryId", categoryVal);
            formData.append("BrandId", brandVal);

            var fileInput = $("#fileProductPicture")[0];
            if (fileInput && fileInput.files.length > 0) {
                formData.append("ProductImage", fileInput.files[0]);
            }

            // 3. Prevent Multiple Clicks
            const $btn = $(this);
            $btn.prop("disabled", true).text("Saving...");

            // 4. AJAX Submission
            $.ajax({
                url: `${APP_CONFIG.API_BASE_URL}api/Product/SaveProduct`,
                type: "POST",
                headers: { 'Authorization': token ? `Bearer ${token}` : '' },
                data: formData,
                processData: false,
                contentType: false, 
                success: function (res) {
                notyf.success(res.message || "Saved Successfully");
                if (res.data) {
                    $("#txtProductCode").val(res.data);
                }
                $btn.prop("disabled", true).text("Saved");
                $("#txtProductCode").prop("disabled", true);
                $("#ddlProductUnitType").prop("disabled", true);
                $("#chkSerialProduct").prop("disabled", true);

                $("#btnSave").addClass("d-none");
                $("#btnUpdate").removeClass("d-none").prop("disabled", false);

                // Show Barcode / QR Code Generation Section
                $("#codeGeneratorSection").removeClass("d-none");

                LoadProducts();
            },
         
                 
                error: function (xhr) { 
                    $btn.prop("disabled", false).text("Save"); 
                    const errRes = xhr.responseJSON;
                    if (errRes && errRes.Message) {
                        notyf.error(errRes.Message || "Failed to save product."); 
                    } else {
                        toastr.error("Failed to save product. Please try again.", "Error");
                    }
                    console.error("Save Error:", xhr);
                }
            });
        });

