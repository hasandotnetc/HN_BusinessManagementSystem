                function BindTable(data) {
                    console.log('bind table data');
                    console.log(data);
            let html = "";
            if (!data || data.length === 0) {
                $("#productTableBody").html("");
                $("#emptyStatePlaceholder").show();
                return;
            }
            $("#emptyStatePlaceholder").hide();

            $.each(data, function(index, item) { 
                const itemJson = JSON.stringify(item).replace(/'/g, "&apos;").replace(/"/g, "&quot;");

                html += `
                    <tr>
                        <td class="fw-semibold">${((currentPage - 1) * pageSize) + (index + 1)}</td>
                        <td>
                            <img src="${getImageUrl(item.imageUrl)}"
                                 width="40"
                                 height="40"
                                 class="rounded border"
                                 style="object-fit: cover;"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='${DEFAULT_IMAGEA}'">
                        </td>
                        <td class="fw-semibold text-dark">${item.productName}</td>
                        <td>${item.code || '-'}</td> 
                        <td>${item.model || '-'}</td>
                        <td>${item.groupName || '-'}</td>
                        <td>${item.categoryName || '-'}</td>
                        <td>${item.brandName || '-'}</td>
                        <td><span class="badge bg-light text-dark border">${item.unitTypeName || 'Standard'}</span></td>

                        <td>${item.activeStatus || '-'}</td>
                        
                        <td class="text-center">
                            <button class="btn btn-action-edit" onclick="EditProduct('${itemJson}')">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                            </button>
                        </td>
                    </tr>
                `;
            });
            $("#productTableBody").html(html);
        }

            function EditProduct(jsonString) {
            const item = typeof jsonString === 'string' ? JSON.parse(jsonString) : jsonString;

            // 1. Populate Hidden ID and Form Controls
            $("#txtProductId").val(item.productId || 0);
            $("#txtProductName").val(item.productName || "");
            $("#txtProductCode").val(item.code || "");
            $("#txtModelNo").val(item.model || "");

            $("#ddlProductUnitType").val(item.unitTypeId || "").prop("disabled", true);  
            $("#ddlGroup").val(item.productGroupId || item.groupId || "");
            $("#ddlCategory").val(item.categoryId || "");
            $("#ddlBrand").val(item.brandId || ""); 
        const mappedType = item.productType === "I" ? "Inventory" : (item.productType === "S" ? "Service" : item.productType);
        $("#ddlProductType").val(mappedType || "").prop("disabled", true); 
        $("#chkSerialProduct").prop("checked", item.serialAvailable === "Y").prop("disabled", true);
         
            $("#txtProductNote").val(item.productNote || "");
             
            $("#numVat").val(item.vat || 0);
            const isVatPercent = (item.isVatPercentageOrAmount === "P");
            $("#chkVatMode").prop("checked", isVatPercent);
            toggleInputMode('Vat');

            $("#txtWarranty").val(item.warranty || 0); 
            $("#chkActiveStatus").prop("checked", item.activeStatus === "Y" || item.isActive === true);
             
            if (item.imageUrl) {
                imgPreview.src = getImageUrl(item.imageUrl);
                imgPreview.classList.remove('d-none');
                uploadPlaceholder.classList.add('d-none');
            } else {
                imgPreview.src = "";
                imgPreview.classList.add('d-none');
                uploadPlaceholder.classList.remove('d-none');
            }
             
            $("#btnSave").addClass("d-none");
            $("#btnUpdate").removeClass("d-none").prop("disabled", false).text("Edit Product");
             
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
 
        function CreatePagination() {
            let html = "";
            html += `
            <li class="page-item ${currentPage==1?'disabled':''}"> 
                <a class="page-link" href="#"  onclick="GoPage(${currentPage-1})">   Previous </a> 
            </li> `;

            for(let i=1;i<=totalPages;i++){

                html+=`  
                <li class="page-item ${currentPage==i?'active':''}"> 
                    <a class="page-link" href="#"   onclick="GoPage(${i})"> ${i}  </a> 
                </li> `; 
            }

            html+=`
            <li class="page-item ${currentPage==totalPages?'disabled':''}"> 
                 <a class="page-link"  href="#"   onclick="GoPage(${currentPage+1})">  Next </a> 
            </li>  `; 
            $("#pagination").html(html); 
        }


        function GoPage(page){

            if(page<1)
                return;

            if(page>totalPages)
                return;

            currentPage=page;

            LoadProducts();

        }


        $("#txtSearch").keyup(function(){

            currentPage=1;

