@{
    ViewData["Title"] = "Product Setup";
}

<!-- ================= REBECCAPURPLE PERFECT INLINE LAYOUT ================= -->
<style>
    :root {
        --rebecca-solid: #663399;
        --rebecca-dark-bg: #231942;
        --rebecca-gold: #e0aa3e;
        --rebecca-gold-hover: #cc962d;
        --rebecca-border: #804db3;
        --rebecca-table-header: #52297a;
    }

    .product-workspace-wrapper {
        background-color: var(--rebecca-dark-bg);
        color: #ffffff;
        border-radius: 8px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-card-premium {
        background-color: var(--rebecca-solid) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 14px 16px !important;
    }

    .section-title-gold {
        color: var(--rebecca-gold);
        font-weight: 600;
        font-size: 14px;
    }

    .section-title-White {
        color: white;
        font-weight: 600; 
        font-size: 14px;
    }

    /* Standardized inline row items alignment */
    .inline-label {
        color: #ffffff;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        min-width: 95px;
        display: flex;
        align-items: center;
    }

    .custom-form-control {
        background-color: #ffffff !important;
        color: #111111 !important;
        border: 1px solid var(--rebecca-border) !important;
        border-radius: 4px !important;
        padding: 4px 8px;
        font-size: 12px;
        height: 28px !important;
    }

    /* Style for the 'Per(%)' indicator text */
    .per-text-indicator {
        font-size: 11px;
        color: #dfd5f0;
        white-space: nowrap;
        font-weight: 500;
    }

    /* Clean Checkbox Design matching the drawing layout */
    .row-aligned-checkbox {
        width: 15px;
        height: 15px;
        cursor: pointer;
        accent-color: var(--rebecca-gold);
    }

    .btn-gold-action {
        background-color: var(--rebecca-gold);
        color: #1a0f30 !important;
        font-weight: 700;
        border: none;
        padding: 5px 20px;
        border-radius: 4px;
        font-size: 12px;
    }

        .btn-gold-action:hover {
            background-color: var(--rebecca-gold-hover);
        }

    .btn-purple-utility {
        background-color: #52297a;
        color: #ffffff !important;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 4px;
        padding: 2px 10px;
        font-size: 11px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .uploader-box {
        border: 1px dashed rgba(255,255,255,0.4);
        background-color: rgba(0, 0, 0, 0.15);
        border-radius: 6px;
        cursor: pointer;
        height: 125px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .premium-table-container {
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--rebecca-border);
        min-height: 220px;
        font-size: 12px;
    }

    .premium-data-table th {
        background-color: var(--rebecca-table-header) !important;
        color: #e2d5f0 !important;
        font-weight: 500;
        font-size: 12px;
        font-style:initial;
        padding: 8px 10px !important;
    }

    .premium-data-table td {
        background-color: transparent !important;
        color: #ffffff !important;
        border-bottom: 1px solid rgba(255,255,255,0.08) !important;
        padding: 8px 10px !important;
    }

    .mandatory-star {
        color: #ff4d4d;
        margin-left: 2px;
    }
</style>

<div class="container-fluid p-2 product-workspace-wrapper my-0">

    <!-- ================= ROW 1: PRODUCT FORM SECTION ================= -->
    <div class="form-card-premium mb-3">
        <div class="border-bottom border-secondary pb-1 mb-3 d-flex align-items-center">
            <i class="fa-solid fa-square-poll-horizontal text-warning me-2" style="font-size: 13px;"></i>
            <h2 class="section-title-White m-0 text-uppercase tracking-wider">Product Information</h2>
        </div>

        <form id="productForm" onsubmit="handleFormSubmit(event)" novalidate>
            <div class="row g-3 align-items-start">

                <!-- COLUMN 1: Basic Input Fields + Inline Serial Product -->
                <div class="col-xl-3 col-md-6">
                    <!-- Product Name -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="txtProductName">Product Name<span class="mandatory-star">*</span></label>
                        <div class="w-100">
                            <input type="text" id="txtProductName" class="form-control custom-form-control" placeholder="Enter product name" maxlength="500">
                            <div id="errProductName" class="text-danger d-none" style="font-size:10px; position:absolute;">Required</div>
                        </div>
                    </div>
                    <!-- Model No -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="txtModelNo">Model No</label>
                        <input type="text" id="txtModelNo" class="form-control custom-form-control" placeholder="Enter model number">
                    </div>
                    <!-- Price -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="numPrice">Price<span class="mandatory-star">*</span></label>
                        <div class="w-100">
                            <input type="number" id="numPrice" class="form-control custom-form-control" placeholder="0.00" step="0.01">
                            <div id="errPrice" class="text-danger d-none" style="font-size:10px; position:absolute;">Required</div>
                        </div>
                    </div>
                    <!-- Serial Product: Transformed into perfect row matching layout -->
                    <div class="d-flex align-items-center mb-0">
                        <label class="inline-label" for="chkSerialProduct">Serial Product</label>
                        <div class="d-flex align-items-center" style="height: 28px;">
                            <input type="checkbox" id="chkSerialProduct" class="row-aligned-checkbox">
                        </div>
                    </div>
                </div>

                <!-- COLUMN 2: Beautiful Single-Line Convertible Operations (Discount, VAT, Tax) -->
                <div class="col-xl-3 col-md-6">
                    <!-- Discount Row -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" id="lblDiscount" for="numDiscount">Discount ($)</label>
                        <div class="d-flex align-items-center gap-2 w-100">
                            <input type="number" id="numDiscount" class="form-control custom-form-control w-100" placeholder="0.00" value="0.00" step="0.01">
                            <span class="per-text-indicator">Per(%)</span>
                            <input type="checkbox" id="chkDiscountMode" onchange="toggleInputMode('Discount')" class="row-aligned-checkbox">
                        </div>
                    </div>

                    <!-- VAT Row -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" id="lblVat" for="numVat">Vat ($)</label>
                        <div class="d-flex align-items-center gap-2 w-100">
                            <input type="number" id="numVat" class="form-control custom-form-control w-100" placeholder="0.00" value="0.00" step="0.01">
                            <span class="per-text-indicator">Per(%)</span>
                            <input type="checkbox" id="chkVatMode" onchange="toggleInputMode('Vat')" class="row-aligned-checkbox">
                        </div>
                    </div>

                    <!-- Tax Row -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" id="lblTax" for="numTax">Tax ($)</label>
                        <div class="d-flex align-items-center gap-2 w-100">
                            <input type="number" id="numTax" class="form-control custom-form-control w-100" placeholder="0.00" value="0.00" step="0.01">
                            <span class="per-text-indicator">Per(%)</span>
                            <input type="checkbox" id="chkTaxMode" onchange="toggleInputMode('Tax')" class="row-aligned-checkbox">
                        </div>
                    </div>

                    <!-- Warranty Row -->
                    <div class="d-flex align-items-center mb-0">
                        <label class="inline-label" for="txtWarranty">Warranty</label>
                        <input type="text" id="txtWarranty" class="form-control custom-form-control w-100" placeholder="e.g. 1 Year">
                    </div>
                </div>

                <!-- COLUMN 3: Product Picture Upload Area -->
                <div class="col-xl-2 col-md-4">
                    <div class="uploader-box">
                        <input type="file" id="fileProductPicture" class="position-absolute w-100 h-100 top-0 start-0 opacity-0" style="cursor: pointer;" accept="image/*">
                        <div id="uploadPlaceholder" class="text-center p-1">
                            <i class="fa-solid fa-cloud-arrow-up text-white-50 mb-1" style="font-size:16px;"></i>
                            <div class="fw-bold text-white" style="font-size:11px;">Click to upload image</div>
                            <div style="font-size: 9px;" class="text-white-50">PNG, JPG up to 5MB</div>
                        </div>
                        <img id="imgPreview" class="w-100 h-100 object-fit-contain d-none rounded" alt="Preview">
                    </div>
                </div>

                <!-- COLUMN 4: Dropdowns Selector Fields -->
                 

                <div class="col-xl-4 col-md-8">
                     
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">
                            Group <span class="mandatory-star">*</span>
                        </label>

                        <div class="d-flex gap-1 w-100">

                            <select id="ddlGroup" class="form-select custom-form-control">
                            </select>

                            <button type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>

                        </div>
                    </div>

                    <!-- ===========================
                        CATEGORY
                    =========================== -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">
                            Category <span class="mandatory-star">*</span>
                        </label>

                        <div class="d-flex gap-1 w-100">

                            <select id="ddlCategory" class="form-select custom-form-control">
                            </select>

                            <button type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>

                        </div>
                    </div>

                    <!-- ===========================
                        BRAND
                    =========================== -->
                    <div class="d-flex align-items-center">
                        <label class="inline-label">
                            Brand <span class="mandatory-star">*</span>
                        </label>

                        <div class="d-flex gap-1 w-100">

                            <select id="ddlBrand" class="form-select custom-form-control">
                            </select>

                            <button type="button" class="btn btn-purple-utility">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>

                        </div>
                    </div>
                </div>

            </div>

            <!-- Form Action Footer -->
            <div class="d-flex justify-content-end gap-2 pt-2 mt-3 border-top border-secondary">
                <button type="button" onclick="resetForm()" class="btn btn-purple-utility h-auto py-1 px-3">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </button>
                <button id="btnSave" type="submit" class="btn btn-gold-action">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Product
                </button>
            </div>
        </form>
    </div>

    <!-- ================= ROW 2: PRODUCT LIST CONTAINER ================= -->
    <div class="form-card-premium">
        <div class="row g-2 align-items-center justify-content-between pb-1.5 mb-2 border-bottom border-secondary">
            <div class="col-sm-4">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-list-ul text-warning me-2" style="font-size:13px;"></i>
                    <h3 class="section-title-White m-0 text-uppercase tracking-wider" style="font-size:14px;">Product List</h3>
                </div>
            </div>
            <div class="col-sm-8">
                <div class="d-flex flex-wrap align-items-center justify-content-sm-end gap-2">
                    <div class="input-group" style="max-width: 300px; height: 22px;">
                        <input type="text" id="txtSearch" class="form-control bg-white border-secondary text-black text-xs py-0" placeholder="Search by Product or Brand or Group or Category" style="height:26px;">
                        <button class="btn btn-purple-utility px-2 py-0" type="button" style="height:22px;"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </div>
                    <div class="d-flex align-items-center gap-1" style="font-size:11px;">
                        <span class="text-white-50">Show</span>
                        <select id="ddlPageSize" class="form-select bg-dark border-secondary text-white py-0 px-1" style="width: auto; font-size:11px; height:24px;">
                            <option value="10">10</option>
                            <option value="25">25</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-purple-utility py-0 px-2" style="font-size:11px; height:26px;"><i class="fa-solid fa-plus me-1"></i> Add Product</button>
                </div>
            </div>
        </div>

        <div class="table-responsive premium-table-container position-relative">
            <table class="table premium-data-table align-middle m-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Model No</th>
                        <th>Group</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th>Price</th>
                        <th>Stock Type</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="productTableBody"></tbody>
            </table>


            <div class="d-flex justify-content-between align-items-center mt-2">

                <div id="paginationInfo"
                     class="text-white-50"
                     style="font-size:12px;">
                    Showing 0-0 of 0 Products
                </div>

                <nav>
                    <ul id="pagination"
                        class="pagination pagination-sm mb-0">
                    </ul>
                </nav>

            </div>

            <div id="emptyStatePlaceholder" class="text-center py-5 m-0">
                <i class="fa-solid fa-box-open text-warning mb-2" style="font-size:24px;"></i>
                <div class="text-white fw-bold" style="font-size:13px;">No Registered Products Found</div>
                <p class="text-white-50 m-0" style="font-size:11px;">Your workspace inventory repository database runtime is currently empty.</p>
            </div>
        </div>
    </div>
</div>

<!-- ================= ENGINE LOGIC CONTAINER ================= -->
@section Scripts {
    <script>
        const imgInput = document.getElementById('fileProductPicture');
        const imgPreview = document.getElementById('imgPreview');
        const uploadPlaceholder = document.getElementById('uploadPlaceholder');

        $(document).ready(function() {
            imgInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                        imgPreview.classList.remove('d-none');
                        uploadPlaceholder.classList.add('d-none');
                    }
                    reader.readAsDataURL(file);
                }
            });
        });

        // Smart dynamic labels handler
        function toggleInputMode(fieldName) {
            const isChecked = document.getElementById(`chk${fieldName}Mode`).checked;
            const label = document.getElementById(`lbl${fieldName}`);

            // Switch label text synchronously without breaking the design layout row
            if (isChecked) {
                label.innerText = `${fieldName} (%)`;
            } else {
                label.innerText = `${fieldName} ($)`;
            }
        }

        function calculateCalculatedValue(fieldName, mainPrice) {
            const inputVal = parseFloat(document.getElementById(`num${fieldName}`).value) || 0;
            const isPercent = document.getElementById(`chk${fieldName}Mode`).checked;
            return isPercent ? (mainPrice * inputVal) / 100 : inputVal;
        }


        function handleFormSubmit(e) {
            e.preventDefault();

            const mainPrice = parseFloat($("#numPrice").val()) || 0;

            if ($("#txtProductName").val().trim() === "" || mainPrice <= 0) {
                alert("Please fill required fields.");
                return;
            }

            const product = {
                ProductName: $("#txtProductName").val().trim(),
                ModelNo: $("#txtModelNo").val(),
                Price: mainPrice,

                Discount: calculateCalculatedValue('Discount', mainPrice),
                Vat: calculateCalculatedValue('Vat', mainPrice),
                Tax: calculateCalculatedValue('Tax', mainPrice),

                IsDiscountPercent: $("#chkDiscountMode").prop("checked"),
                IsVatPercent: $("#chkVatMode").prop("checked"),
                IsTaxPercent: $("#chkTaxMode").prop("checked"),

                Warranty: $("#txtWarranty").val(),

                IsSerialProduct: $("#chkSerialProduct").prop("checked"),

                GroupId: $("#ddlGroup").val(),
                CategoryId: $("#ddlCategory").val(),
                BrandId: $("#ddlBrand").val()
            };

            console.log(product);fileProductPicture

            saveProduct(product);
        }


        // function saveProduct() {

        //     var formData = new FormData();

        //     formData.append("ProductName", $("#txtProductName").val());
        //     formData.append("ModelNo", $("#txtModelNo").val());
        //     formData.append("Price", $("#numPrice").val());

        //     formData.append("Discount", calculateCalculatedValue('Discount', $("#numPrice").val()));
        //     formData.append("Vat", calculateCalculatedValue('Vat', $("#numPrice").val()));
        //     formData.append("Tax", calculateCalculatedValue('Tax', $("#numPrice").val());

        //     formData.append("IsDiscountPercent", $("#chkDiscountMode").prop("checked"));
        //     formData.append("IsVatPercent", $("#chkVatMode").prop("checked"));
        //     formData.append("IsTaxPercent", $("#chkTaxMode").prop("checked"));

        //     formData.append("IsSerialProduct", $("#chkSerialProduct").prop("checked"));

        //     formData.append("Warranty", $("#txtWarranty").val());

        //     formData.append("GroupId", $("#ddlGroup").val());
        //     formData.append("CategoryId", $("#ddlCategory").val());
        //     formData.append("BrandId", $("#ddlBrand").val());

        //     var file = $("#fileProductPicture")[0].files[0];

        //     if (file) {
        //         formData.append("Image", file);
        //     }

        //     $.ajax({
        //         url: "https://localhost:7008/api/Product/Save",
        //         type: "POST",
        //         data: formData,
        //         processData: false,
        //         contentType: false,

        //         success: function (res) {
        //             alert("Saved Successfully");
        //         },

        //         error: function (err) {
        //             console.log(err);
        //         }
        //     });
        // }

        function resetForm() {
            document.getElementById('productForm').reset();
            imgPreview.src = "";
            imgPreview.classList.add('d-none');
            uploadPlaceholder.classList.remove('d-none');
            ['Discount', 'Vat', 'Tax'].forEach(mode => toggleInputMode(mode));
        }






        const API_BASE_URL = "https://localhost:7008/api/Product";

        $(document).ready(function () {

            loadMasterDropdowns();

        });

        async function loadMasterDropdowns() {
            // alert("je;;p");
            try {

                await Promise.all([

                    loadDropdown(
                        `${API_BASE_URL}/AllProductGroupList`,
                        "#ddlGroup",
                        "productGroupId",
                        "name",
                        "Select Group"
                    ),

                    loadDropdown(
                        `${API_BASE_URL}/AllProductCategoryList`,
                        "#ddlCategory",
                        "categoryId",
                        "name",
                        "Select Category"
                    ),

                    loadDropdown(
                        `${API_BASE_URL}/AllProductBrandList`,
                        "#ddlBrand",
                        "brandId",
                        "name",
                        "Select Brand"
                    )

                ]);

                // Select2 ব্যবহার করলে
                /*
                $("#ddlGroup").select2({ width: '100%' });
                $("#ddlCategory").select2({ width: '100%' });
                $("#ddlBrand").select2({ width: '100%' });
                */

            }
            catch (error) {

                console.error(error);

            }

        }

        async function loadDropdown(apiUrl, ddlId, valueField, textField, defaultText) {

            try {

                const response = await fetch(apiUrl);

                if (!response.ok)
                    throw new Error("Failed to Load : " + apiUrl);

                const data = await response.json();

                let html = `<option value="">${defaultText}</option>`;

                data.forEach(item => {

                    html += `
                        <option value="${item[valueField]}">
                            ${item[textField]}
                        </option>
                    `;

                });

                $(ddlId).html(html);

            }
            catch (error) {

                console.error(error);

            }

        }
        // $("#btnSave").click(function(){
        //      const groupId = $("#ddlGroup").val();
        // const categoryId = $("#ddlCategory").val();
        // const brandId = $("#ddlBrand").val();

       
        // })
                let currentPage = 1;
        let pageSize = 10;
        let totalPages = 0;
                       $(document).ready(function () {

            LoadProducts();

        });

                function LoadProducts() {

            $.ajax({

                url: "https://localhost:7008/api/SearchingByDapper/GetProductByPaginationRequest", 
                type: "GET", 
                data: { 
                    Page: currentPage, 
                    PageSize: pageSize, 
                      Search: ($("#txtSearch").val() || "").trim()
                },
                success: function (res) {
                      console.log(res);
                    BindTable(res.data);
                    totalPages = res.totalPages;
                    CreatePagination();
                    $("#paginationInfo").html(
                        `Showing ${((currentPage-1)*pageSize)+1}
                         -
                         ${Math.min(currentPage*pageSize,res.totalRecords)}
                         of
                         ${res.totalRecords}
                         Products`
                    );

                }
             
            });

        }


                function BindTable(data) {

            let html = "";

            if (data.length == 0) {

                $("#productTableBody").html("");

                $("#emptyStatePlaceholder").show();

                return;

            }

            $("#emptyStatePlaceholder").hide();

            $.each(data,function(index,item){

                html += `
        <tr>

        <td>${((currentPage-1)*pageSize)+(index+1)}</td>

        <td>
        <img src="${item.image}"
        width="40">
        </td>

        <td>${item.productName}</td>

        <td>${item.model}</td>

        <td>${item.groupName}</td>

        <td>${item.categoryName}</td>

        <td>${item.brandName}</td>

        <td>${item.price}</td>

        <td>${item.stockType}</td>

        <td>

        <button class="btn btn-sm btn-warning">
        Edit
        </button>

        </td>

        </tr>
        `;

            });

            $("#productTableBody").html(html);

        }


                function CreatePagination() {

            let html = "";

            html += `
        <li class="page-item ${currentPage==1?'disabled':''}">

        <a class="page-link"
        href="#"
        onclick="GoPage(${currentPage-1})">

        Previous

        </a>

        </li>
        `;

            for(let i=1;i<=totalPages;i++){

                html+=`
        <li class="page-item ${currentPage==i?'active':''}">

        <a class="page-link"

        href="#"

        onclick="GoPage(${i})">

        ${i}

        </a>

        </li>
        `;

            }

            html+=`
        <li class="page-item ${currentPage==totalPages?'disabled':''}">

        <a class="page-link"

        href="#"

        onclick="GoPage(${currentPage+1})">

        Next

        </a>

        </li>
        `;

            $("#pagination").html(html);

        }


                function GoPage(page){

            if(page<1)
                return;

            if(page>totalPages)
                return;

            currentPage=page;

            LoadProducts();

        }


                $("#txtSearch").keyup(function(){

            currentPage=1;

            LoadProducts();

        });

                $("#ddlPageSize").change(function(){

            pageSize=parseInt($(this).val());

            currentPage=1;

            LoadProducts();

        });


    </script>
}