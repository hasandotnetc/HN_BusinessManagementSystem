        function calculateCalculatedValue(type, price) { 
            let value = 0;
            let isPercent = false; 
            switch (type) {
              
                case "Vat":
                    value = parseFloat($("#numVat").val()) || 0;
                    isPercent = $("#chkVatMode").prop("checked");
                    break;

                case "Tax":
                    value = parseFloat($("#numTax").val()) || 0;
                    isPercent = $("#chkTaxMode").prop("checked");
                    break;
            }

            if (isPercent) {
                return (price * value) / 100;
            }

            return value;
        }
         
