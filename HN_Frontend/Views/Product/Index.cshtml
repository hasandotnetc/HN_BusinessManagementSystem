                let generatedCodeType = null;


        async function generateCode(type) {

            generatedCodeType = type;

            const productName = $("#txtProductName").val().trim();
            const productCode = $("#txtProductCode").val().trim();

            if (!productCode || !productName) {
                notyf.error("Product Name and Code are required to generate tags!");
                return;
            }

            const paperSize = $("#ddlPaperSize").val();

            let labelCount = 1;

            if (paperSize === "A4") {
                labelCount = parseInt($("#numA4Count").val()) || 24;
            }

            const $printArea = $("#printArea");

            $printArea.empty();


            // =====================================================
            // BARCODE
            // =====================================================

            if (type === "BARCODE") {

                $("#codeModalTitle").html(
                    '<i class="fa-solid fa-barcode me-2"></i> Barcode Labels'
                );

                for (let i = 0; i < labelCount; i++) {

                    const cardId = `barcode-svg-${i}`;

                    const itemHtml = `
                        <div class="barcode-card"
                             style="
                                width:170px;
                                height:100px;
                                box-sizing:border-box;
                                padding:6px 8px;
                                text-align:center;
                                border:1px solid var(--rebecca-solid);
                                border-radius:8px;
                                background:#fff;
                                overflow:hidden;
                                display:flex;
                                flex-direction:column;
                                align-items:center;
                             ">

                            <!-- Product Name -->
                            <div style="
                                width:100%;
                                height:28px;
                                font-size:11px;
                                font-weight:700;
                                color:#333;
                                line-height:14px;
                                text-align:center;

                                display:-webkit-box;
                                -webkit-line-clamp:2;
                                -webkit-box-orient:vertical;

                                overflow:hidden;
                                text-overflow:ellipsis;

                                word-break:break-word;
                                overflow-wrap:anywhere;

                                flex-shrink:0;
                            ">
                                ${productName}
                            </div>


                            <!-- Barcode -->
                            <div style="
                                width:100%;
                                height:42px;
                                display:flex;
                                justify-content:center;
                                align-items:center;
                                flex-shrink:0;
                                margin-top:2px;
                            ">
                                <svg id="${cardId}"
                                     style="
                                        max-width:100%;
                                        height:40px;
                                        display:block;
                                     ">
                                </svg>
                            </div>


                            <!-- Product Code -->
                            <div style="
                                width:100%;
                                height:16px;
                                font-size:10px;
                                font-weight:600;
                                color:var(--rebecca-solid);
                                letter-spacing:1px;
                                line-height:16px;
                                text-align:center;

                                white-space:nowrap;
                                overflow:hidden;
                                text-overflow:ellipsis;

                                flex-shrink:0;
                            ">
                                ${productCode}
                            </div>

                        </div>
                    `;

                    $printArea.append(itemHtml);


                    JsBarcode(`#${cardId}`, productCode, {

                        format: "CODE128",

                        width: 1.5,

                        height: 40,

                        displayValue: false,

                        margin: 0,

                        lineColor: "#1a0f30"
                    });
                }
            }


            // =====================================================
            // QR CODE
            // =====================================================

            else if (type === "QRCODE") {

                $("#codeModalTitle").html(
                    '<i class="fa-solid fa-qrcode me-2"></i>QR Code Labels'
                );

                const companyInfo = await getCompanyDetails();

                const qrText =
                    `Company: ${companyInfo.companyName}\n` +
                    `Web: ${companyInfo.websiteLink}\n` +
                    `Product: ${productName}`;


                for (let i = 0; i < labelCount; i++) {

                    const qrContainerId = `qrcode-div-${i}`;

                    const itemHtml = `
                        <div class="qrcode-card bg-white"
                             style="
                                width:170px;
                                height:188px;

                                display:flex;
                                align-items:center;
                                justify-content:center;

                                background:#fff;

                                overflow:hidden;
                             ">

                            <div id="${qrContainerId}"></div>

                        </div>
                    `;

                    $printArea.append(itemHtml);


                    /*
                     * UTF-8
                     */

                    const utf8Bytes =
                        new TextEncoder().encode(qrText);

                    let binaryData = "";

                    for (const byte of utf8Bytes) {
                        binaryData += String.fromCharCode(byte);
                    }


                    /*
                     * Create QR
                     */

                    const qr = qrcode(0, "M");

                    qr.addData(binaryData, "Byte");

                    qr.make();


                    /*
                     * SVG
                     */

                    const svg = qr.createSvgTag({
                        scalable: true,
                        margin: 0
                    });


                    const container =
                        document.getElementById(qrContainerId);

                    container.innerHTML = svg;


                    const svgElement =
                        container.querySelector("svg");


                    if (svgElement) {

                        svgElement.setAttribute(
                            "width",
                            "165"
                        );

                        svgElement.setAttribute(
                            "height",
                            "165"
                        );

                        svgElement.style.width = "165px";

                        svgElement.style.height = "165px";

                        svgElement.style.display = "block";
                    }
                }
            }


            /*
             * Show preview
             */

            const previewModal =
                new bootstrap.Modal(
                    document.getElementById("modalCodePreview")
                );

            previewModal.show();
        }


                async function printGeneratedCode() {

            const printArea =
                document.getElementById("printArea");

            if (!printArea || !printArea.innerHTML.trim()) {

                notyf.error(
                    "No code available to print!"
                );

                return;
            }


            if (typeof html2canvas === "undefined") {

                console.error(
                    "html2canvas is not loaded."
                );

                notyf.error(
                    "html2canvas library is not loaded!"
                );

                return;
            }


            if (
                !window.jspdf ||
                !window.jspdf.jsPDF
            ) {

                console.error(
                    "jsPDF is not loaded."
                );

                notyf.error(
                    "PDF library is not loaded!"
                );

                return;
            }


            try {

                const { jsPDF } = window.jspdf;


                // =====================================================
                // A4 SETTINGS
                // =====================================================

                const marginX = 10;
                const marginY = 10;

                const cardWidth = 45;
                const cardHeight =
                    generatedCodeType === "BARCODE"
                        ? 27
                        : 50;

                const gapX = 3;
                const gapY = 3;

                const columns = 4;
                const rows =
                    generatedCodeType === "BARCODE"
                        ? 9
                        : 5;


                // =====================================================
                // CREATE PDF
                // =====================================================

                const pdf = new jsPDF({

                    orientation: "portrait",

                    unit: "mm",

                    format: "a4",

                    compress: true
                });


                // =====================================================
                // GET CARDS BASED ON TYPE
                // =====================================================

                const selector =
                    generatedCodeType === "BARCODE"
                        ? ".barcode-card"
                        : ".qrcode-card";


                const cards = Array.from(
                    printArea.querySelectorAll(selector)
                );


                if (cards.length === 0) {

                    notyf.error(
                        generatedCodeType === "BARCODE"
                            ? "No barcode found!"
                            : "No QR code found!"
                    );

                    return;
                }


                // =====================================================
                // TEMP CONTAINER
                // =====================================================

                const renderContainer =
                    document.createElement("div");


                renderContainer.style.position =
                    "fixed";

                renderContainer.style.left =
                    "-100000px";

                renderContainer.style.top =
                    "0";

                renderContainer.style.background =
                    "#ffffff";

                renderContainer.style.zIndex =
                    "-9999";


                document.body.appendChild(
                    renderContainer
                );


                // =====================================================
                // RENDER CARD
                // =====================================================

                async function addCardToPDF(
                    card,
                    x,
                    y
                ) {

                    const clone =
                        card.cloneNode(true);


                    if (
                        generatedCodeType ===
                        "BARCODE"
                    ) {

                        /*
                         * Barcode
                         */

                        clone.style.width =
                            "170px";

                        clone.style.height =
                            "100px";

                        clone.style.boxSizing =
                            "border-box";

                        clone.style.backgroundColor =
                            "#ffffff";

                        clone.style.margin =
                            "0";

                        clone.style.padding =
                            "6px 8px";

                    }
                    else {

                        /*
                         * QR
                         */

                        clone.style.width =
                            "170px";

                        clone.style.height =
                            "188px";

                        clone.style.boxSizing =
                            "border-box";

                        clone.style.backgroundColor =
                            "#ffffff";

                        clone.style.margin =
                            "0";

                        clone.style.padding =
                            "0";
                    }


                    clone.style.fontFamily =
                        "Arial, sans-serif";

                    clone.style.transform =
                        "none";

                    clone.style.boxShadow =
                        "none";


                    renderContainer.innerHTML =
                        "";

                    renderContainer.appendChild(
                        clone
                    );


                    await new Promise(
                        resolve =>
                            requestAnimationFrame(
                                resolve
                            )
                    );


                    // =================================================
                    // HIGH RESOLUTION
                    // =================================================

                    const canvas =
                        await html2canvas(
                            clone,
                            {

                                scale: 4,

                                useCORS: true,

                                allowTaint: false,

                                backgroundColor:
                                    "#ffffff",

                                logging: false,

                                imageTimeout:
                                    15000,

                                width: 170,

                                height:
                                    generatedCodeType ===
                                    "BARCODE"
                                        ? 100
                                        : 188,

                                windowWidth: 170,

                                windowHeight:
                                    generatedCodeType ===
                                    "BARCODE"
                                        ? 100
                                        : 188
                            }
                        );


                    const imageData =
                        canvas.toDataURL(
                            "image/png"
                        );


                    // =================================================
                    // ADD TO PDF
                    // =================================================

                    pdf.addImage(

                        imageData,

                        "PNG",

                        x,

                        y,

                        cardWidth,

                        cardHeight,

                        undefined,

                        "NONE"
                    );
                }


                // =====================================================
                // PAGE GENERATION
                // =====================================================

                let index = 0;

                let pageNumber = 0;


                while (index < cards.length) {

                    if (pageNumber > 0) {

                        pdf.addPage();
                    }


                    for (
                        let row = 0;
                        row < rows;
                        row++
                    ) {

                        for (
                            let col = 0;
                            col < columns;
                            col++
                        ) {

                            if (
                                index >=
                                cards.length
                            ) {
                                break;
                            }


                            const x =
                                marginX +
                                col *
                                (cardWidth + gapX);


                            const y =
                                marginY +
                                row *
                                (cardHeight + gapY);


                            await addCardToPDF(

                                cards[index],

                                x,

                                y
                            );


                            index++;
                        }
                    }


                    pageNumber++;
                }


                // =====================================================
                // CLEAN
                // =====================================================

                document.body.removeChild(
                    renderContainer
                );


                // =====================================================
                // OPEN PDF
                // =====================================================

                const blob =
                    pdf.output("blob");


                const url =
                    URL.createObjectURL(blob);


                window.open(
                    url,
                    "_blank"
                );


                notyf.success(
                    generatedCodeType === "BARCODE"
                        ? "Barcode PDF generated successfully!"
                        : "QR Code PDF generated successfully!"
                );


                setTimeout(
                    () => {
                        URL.revokeObjectURL(
                            url
                        );
                    },
                    60000
                );


            }
            catch (error) {

                console.error(
                    "PDF generation error:",
                    error
                );

                notyf.error(
                    "Failed to generate PDF!"
                );
            }
        }



