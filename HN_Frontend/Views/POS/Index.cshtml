                </div>
            `);
        }
    });
    }







    // =========================================================================
    // 1. ACTIVE ORDER CART ENGINE (DASHBOARD GRID & CALCULATION LOGIC)
    // =========================================================================
    $(document).ready(function () {
        // Array variable holding local memory state for the active customer cart session
        let productCartList = [];
        renderCartGrid();

        // A. Intercept the product item listing button dispatch event
        $(document).on("click", ".btn-add-cart", function (e) {
            e.preventDefault();

            const btn = $(this);

            // Extract metrics explicitly from data attributes to decouple business logic from UI design
            const productId   = btn.data("id");
            const productName = btn.data("name");
            const productCode = btn.data("code");
            const serialNo    = btn.data("serial") ? String(btn.data("serial")).trim() : "";
            const model       = btn.data("model") || "N/A";
            const imageSrc    = btn.data("image") || "";
            const productPrice = parseFloat(btn.data("price")) || 0;

            // Isolate serialized items vs standard bulk commodities
            const isSerialized = (serialNo !== "" && serialNo !== "N/A");
            const lookupSerial = isSerialized ? serialNo : "N/A";

            // Compound unique constraint evaluation: matching both ID and Serial Number
            let existingItem = productCartList.find(item => item.id === productId && item.serialNo === lookupSerial);

            if (existingItem) {
                if (isSerialized) { 
                    ShowWarningToast(
                            "Duplicate Serial Number", 
                            `Serial <strong>${serialNo}</strong> for <strong> ${productName}</strong> is already active in your cart layout.`
                    );
                    return; 
                } else {
                    // Standard non-serialized products can scale quantity infinitely
                    existingItem.quantity += 1;
                }
            } 
            else {
                // Setup fresh operational business entity payload maps
                productCartList.push({
                    id: productId,
                    name: productName,
                    code: productCode,
                    serialNo: lookupSerial,
                    model: model,
                    image: imageSrc,
                    price: productPrice,
                    quantity: 1,
                    discount: 0
                });
            }

            renderCartGrid();
        });




     function ShowWarningToast(title, message) {
        // 1. Ensure the global container box exists in the DOM body
        if ($("#toast-container").length === 0) {
            $("body").append('<div id="toast-container"></div>');
        }

        // 2. Build the structured modern card layout
        const toastHtml = `
            <div class="pos-toast">
                <div class="toast-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="toast-content">
                    <div class="toast-title">${title}</div>
                    <div class="toast-message">${message}</div>
                </div>
            </div>
        `;

        const $toast = $(toastHtml);
        $("#toast-container").append($toast);

        // 3. Automatically fade out and clean up the DOM element after 3.5 seconds
        setTimeout(function() {
            $toast.addClass("toast-fade-out");
            setTimeout(() => $toast.remove(), 300); // Remove element completely after animation finishes
        }, 3500);
    }

        // B. Render & Update Layout View Core Implementation
        function renderCartGrid() {
            const container = $("#cartItemsContainer");
            container.empty();

            if (productCartList.length === 0) {
                container.html(`
                    <div class="cart-empty-state-modern">
                        <div class="animation-wrapper">
                            <div class="radar-pulse"></div>
                            <div class="cart-icon-box">
                                <i class="fa-solid fa-basket-shopping"></i>
                            </div>
                        </div>
                        <h3 class="empty-title">Cart is Empty</h3>
                        <p class="empty-subtitle">Select products from the left pane to build an order</p>
                        <div class="direction-indicator">
                            <i class="fa-solid fa-arrow-left"></i> Ready to scan or add items
                        </div>
                    </div>
                `);

                calculateTotals(); 
                return;
            }

            productCartList.forEach((item, index) => {
                const rowTotal = (item.price * item.quantity) - item.discount;
                const slNo = String(index + 1).padStart(2, '0');

                // Generate clean image markup conditionally
                const imageHtml = item.image
                    ? `<img src="${item.image}" class="product-image" alt="${item.name}">`
                    : `<div class="product-image-placeholder"><i class="fa-solid fa-box"></i></div>`;

                // Display #SL or Model context subtext gracefully
                const dynamicSubtext = item.serialNo !== "N/A" ? `#SL: ${item.serialNo}` : `Model: ${item.model}`;

                // Check if serialized to disable quantity editing directly in the grid
                const qtyReadOnlyAttr = item.serialNo !== "N/A" ? 'readonly style="background:#f1f5f9; cursor:not-allowed;"' : '';

                const itemHtml = `
                    <div class="cart-item-row" data-id="${item.id}" data-serial="${item.serialNo}">
                        <div class="col-sl sl-number">${slNo}</div>
                        <div class="col-product">
                            <div class="product-left">
                                ${imageHtml}
                                <div class="product-details">
                                    <span class="product-name">${item.name}</span>
                                    <span class="product-subtext">Code: ${item.code} | ${dynamicSubtext}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-price">
                            <input type="number" class="cart-grid-input input-row-price" value="${item.price}" min="0" step="any">
                        </div>
                        <div class="col-qty">
                            <input type="number" class="cart-grid-input input-row-qty" value="${item.quantity}" min="1" ${qtyReadOnlyAttr}>
                        </div>
                        <div class="col-discount">
                            <input type="number" class="cart-grid-input input-row-discount" value="${item.discount}" min="0" step="any">
                        </div>
                        <div class="col-total row-total-val">${rowTotal.toFixed(2)}</div>
                        <div class="col-delete">
                            <button type="button" class="btn-cart-delete"><i class="fa-solid fa-minus-circle"></i></button>
                        </div>
                    </div>`;
                container.append(itemHtml);
            });

            calculateTotals();
                   // container.scrollTop(container[0].scrollHeight);
                        container.animate({
                            scrollTop: container[0].scrollHeight
                        }, 300);
        }



        // C. Dynamic input adjustments mapping to memory calculations state
        $(document).on("input", ".input-row-price, .input-row-qty, .input-row-discount", function () {
            const row = $(this).closest(".cart-item-row");
            const id = row.data("id");
            const serial = row.data("serial");

            const targetItem = productCartList.find(item => item.id === id && item.serialNo === serial);

            if (targetItem) {
                const isSerialized = (targetItem.serialNo !== "" && targetItem.serialNo !== "N/A");
                let typedQty = parseInt(row.find(".input-row-qty").val()) || 1;

                // Security fallback safeguard for manual keyboard inputs
                if (isSerialized && typedQty > 1) {
                    alert("Serialized products are strictly locked to a maximum quantity of 1.");
                    typedQty = 1;
                    row.find(".input-row-qty").val(1);
                }

                targetItem.price = parseFloat(row.find(".input-row-price").val()) || 0;
                targetItem.quantity = typedQty;
                targetItem.discount = parseFloat(row.find(".input-row-discount").val()) || 0;

                // Instantly render updated calculations visually inline
                const updatedRowTotal = (targetItem.price * targetItem.quantity) - targetItem.discount;
                row.find(".row-total-val").text(updatedRowTotal.toFixed(2));

                calculateTotals();
            }
        });

        // D. Handle Item Deletions from active UI Grid View rows
        $(document).on("click", ".btn-cart-delete", function () {
            const row = $(this).closest(".cart-item-row");
            const id = row.data("id");
            const serial = row.data("serial");

            // Use strict inverse evaluation to wipe matching data model nodes completely out
            productCartList = productCartList.filter(item => !(item.id === id && item.serialNo === serial));
            renderCartGrid();
        });

        // E. Global Calculation Engine for Checkout totals
        $(document).on("input", "#inputGlobalDiscount, #inputGlobalTax", function () {
            calculateTotals();
        });


            function calculateTotals() {
        // 🚨 FIX 1: If the cart is empty, force all inputs to 0 BEFORE calculating anything
        if (productCartList.length === 0) {
            $("#inputGlobalTax").val(0);
            $("#inputGlobalDiscount").val(0);

            $("#lblSubTotal").text("0.00");
            $("#lblGrandTotal").text("0.00");  
            $("#lblDueAmount").text("0.00");  
            return; // Exit early since nothing else needs calculation
        }

        let subTotal = 0;
        productCartList.forEach(item => {
            subTotal += (item.price * item.quantity) - item.discount;
        });

        const globalDiscount = parseFloat($("#inputGlobalDiscount").val()) || 0;
        const taxPercentage = parseFloat($("#inputGlobalTax").val()) || 0;

        // Apply logic safely
        const intermediateTotal = subTotal - globalDiscount;
        const taxCalculatedAmount = intermediateTotal * (taxPercentage / 100);
        const grandTotal = intermediateTotal + taxCalculatedAmount;
        // console.log('grand Total');
        // console.log(grandTotal);
        // Render localized system presentation parameters safely
        $("#lblSubTotal").text(subTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandTotal").text(grandTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        $("#lblDueAmount").val(grandTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            calculateChangeAmount();
    }
    
    });


    // =========================================================================
    // 2. PRODUCT CATALOG ASYNC AJAX DATA RETRIEVAL (LEFT PANEL PRESENTATION)
    // =========================================================================
    $(function () {
        LoadProducts();
        let typingTimer;

        $("#btnSearchProduct").on("input", function () {
            clearTimeout(typingTimer);
            let keyword = $(this).val();
            typingTimer = setTimeout(function () {
                LoadProducts(keyword);
            }, 500);
        });

        function LoadProducts(searchText = "") {
            $.ajax({
                url: "/POS/GetProductList",
                type: "GET",
                data: { paramObj: searchText },
                success: function (data) {
                    let html = "";
                    if (!data || data.length === 0) {
                        $(".productInfo-box").html(`
                            <div class="empty-state">
                                <i class="fa-solid fa-box-open"></i>
                                <div>No Product Found</div>
                            </div>`);
                        return;
                    }

                    data.forEach(function (p) {
                        const imageHtml = p.picture
                            ? `<img src="${p.picture}" class="product-image" alt="${p.name}">`
                            : `<div class="product-image-placeholder"><i class="fa-solid fa-box"></i></div>`;

                        const subtextContext = p.serialNo ? `#SL: ${p.serialNo}` : `Model: ${p.model || 'N/A'}`;

                        // Embed metrics natively into dataset elements to protect logic against future styling updates
                        html += `
                            <div class="product-item">
                                <div class="product-left">
                                    ${imageHtml}
                                    <div class="product-details">
                                        <span class="product-name">${p.name || ''}</span>
                                        <span class="product-subtext">Code: ${p.code || 'N/A'} | ${subtextContext}</span>
                                    </div>
                                </div>
                                <div class="product-right">
                                    <div>Price: <strong>${(p.price || 0).toLocaleString()}</strong></div>
                                    <div>Stock: <strong style="color:#dc3545">${(p.quantity || 0).toLocaleString()}</strong></div>
                                </div>

                                <button type="button" class="btn-add-cart"
                                        data-id="${p.productId}"
                                        data-name="${escapeHtml(p.name)}"
                                        data-code="${p.code || ''}"
                                        data-serial="${p.serialNo || ''}"
                                        data-model="${p.model || ''}"
                                        data-image="${p.picture || ''}"
                                        data-price="${p.price || 0}">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </button>
                            </div>`;
                    });
                    $(".productInfo-box").html(html);
                },
                error: function (err) {
                    console.error("Critical POS System Failure:", err);
                    $(".productInfo-box").html(`
                        <div class="empty-state">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <div>Failed To Load Products</div>
                        </div>`);
                }
            });
        }

        // Helper utility to safely escape special layout string entities inside HTML fields
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    });

          // ১. হিসাব করার মূল ফাংশন (যাতে যেকোনো জায়গা থেকে কল করা যায়)
    function calculateChangeAmount() {
        // গ্র্যান্ড টোটাল থেকে কমা সরিয়ে পিওর নাম্বার নেওয়া
        let grandTotalTxt = $("#lblGrandTotal").text().trim();
        let grandTotal = parseFloat(grandTotalTxt.replace(/,/g, '')) || 0;

             let totalDueAmountTxt = $("#lblDueAmount").val().trim();
            let totalDueAmount = grandTotal; //  parseFloat(totalDueAmountTxt.replace(/,/g, '')) || 0;


        // পেইড অ্যামাউন্ট থেকে কমা সরিয়ে পিওর নাম্বার নেওয়া
        let rawPaid = $("#inputPaidAmount").val().replace(/,/g, '');
        let paidAmount = parseFloat(rawPaid) || 0;

        let changeDue = paidAmount - grandTotal;
        let availableDueAmount = totalDueAmount - paidAmount;
 

        // if(parseFloat(availableDueAmount)<=0)
        // {
        //   $("#lblDueAmount").val(0);
        // }
       

            // ডিলিউ অ্যামাউন্ট এবং কালার চেঞ্জ কন্ডিশন
        if (availableDueAmount <= 0) {
            // যখন কোনো ডিউ বা বাকি থাকবে না
            $("#lblDueAmount").val("0.00");
            $("#lblDueAmount").addClass("due-clear-green"); // সবুজ রঙের ক্লাস যোগ হবে
        } else {
            // যখন ডিউ বা বাকি থাকবে
                        $("#lblDueAmount").val(availableDueAmount);
            // $("#lblDueAmount").val(availableDueAmount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $("#lblDueAmount").removeClass("due-clear-green"); // সবুজ রঙের ক্লাস চলে যাবে (আগের রঙে ফেরত যাবে)
        }


         
        // ফরম্যাট করে Change Amount ফিল্ডে বসানো
        let formattedChange = changeDue > 0
            ? changeDue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
            : "0.00";

        $("#lblChangeAmount").val(formattedChange);
    }

    // ২. ক্যাশিয়ার যখন Paid Amount ইনপুট ফিল্ডে টাইপ করবেন
    $(document).on("input", "#inputPaidAmount", function () {
        calculateChangeAmount(); // লাইভ হিসাব ট্রিগার হবে
    });


        $(document).ready(function () {

        // Helper Utility: Clear hidden element strings to maintain a pristine database payload
        function resetHiddenPayloadFields() {
            $("#hdnMobileNo").val("");
            $("#hdnCardNo").val("");
            $("#hdnBankName").val("");
            $("#hdnChequeNo").val("");
        }

        // Trigger Invoice Save automatically
        function triggerInvoiceSave() {
            // আপনার সেভ বাটনের ক্লিকের কাজ বা সাবমিট ফাংশনটিকে সরাসরি কল করবে
            $("#btnSaveInvoice").trigger("click");
        }

        // Capture payment configuration adjustments
        $(document).on("change", 'input[name="paymentMethod"]', function () {
            let selectedMethod = $(this).val();
            $("#hdnPaymentType").val(selectedMethod);

            // Wipe previous contextual transaction identities clean automatically
            resetHiddenPayloadFields();

            // Evaluate target modal popup triggers
            if (selectedMethod === "BKash" || selectedMethod === "Nagad" || selectedMethod === "Roket") {
                // Update MFS UI Context Labels dynamically
                $("#mfsModalTitle").text(selectedMethod + " Authentication");
                $("#txtModalMobileNo").val("").attr("placeholder", "Enter " + selectedMethod + " Mobile No");

                // Bring overlay window alive with smooth animation layout transition
                $("#posModalOverlay").addClass("active");
                $("#modalMFS").addClass("active");

                // Redirect autofocus straight into the payload input string instantly
                setTimeout(() => $("#txtModalMobileNo").focus(), 150);

            } else if (selectedMethod === "Card" || selectedMethod === "Cheque") {
                // Adjust banking form contextual properties dynamically
                $("#txtModalRefNo").val("");
                $("#txtModalBankName").val("");
                $("#bankingModalTitle").text(selectedMethod + " Remittance Details");
                $("#lblRefNo").text(selectedMethod === "Card" ? "Card Number (Last 4 digits)" : "Cheque Number");

                $("#posModalOverlay").addClass("active");
                $("#modalBanking").addClass("active");

                setTimeout(() => $("#txtModalRefNo").focus(), 150);
            }
        });

        // Handle Submission validation payload maps
        $("#btnSubmitMFS").on("click", function () {
            let mobileNumber = $("#txtModalMobileNo").val().trim();
            if(mobileNumber !== "") {
                $("#hdnMobileNo").val(mobileNumber);
                closeActivePOSModals();
                triggerInvoiceSave(); // ডেটা কনফার্ম হওয়ার সাথে সাথে ইনভয়েস সেভ হবে
            } else {
                closeActivePOSModals();
            }
        });

        // MFS মোডাল ইনপুটে Enter কি (Key) হ্যান্ডলার
        $("#txtModalMobileNo").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault(); // ফর্মের ডিফল্ট সাবমিট বন্ধ করবে
                $("#btnSubmitMFS").trigger("click"); // সাবমিট বাটনের কাজ সম্পাদন করবে
            }
        });

        $("#btnSubmitBanking").on("click", function () {
            let refNo = $("#txtModalRefNo").val().trim();
            let bankName = $("#txtModalBankName").val().trim();
            let currentMethod = $("#hdnPaymentType").val();

            if (currentMethod === "Card") {
                $("#hdnCardNo").val(refNo);
            } else if (currentMethod === "Cheque") {
                $("#hdnChequeNo").val(refNo);
            }
            $("#hdnBankName").val(bankName);

            closeActivePOSModals();
            triggerInvoiceSave(); // ডেটা কনফার্ম হওয়ার সাথে সাথে ইনভয়েস সেভ হবে
        });

        // Banking মোডাল ইনপুট সমূহে Enter কি (Key) ফ্লো কন্ট্রোল
        $("#txtModalRefNo").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                $("#txtModalBankName").focus(); // প্রথম ঘরে Enter দিলে ব্যাংক নামের ঘরে ফোকাস যাবে
            }
        });

        $("#txtModalBankName").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                $("#btnSubmitBanking").trigger("click"); // ব্যাংক নাম লিখে Enter দিলে সেভ হবে
            }
        });

        // Close Modals Safely (via Close button or Escape Key triggers)
        $(".btn-modal-close").on("click", function () {
            // Automatically default back to Cash to prevent orphan data entries
            fallbackToCashPayment();
        });

        // Auto-Close Window Handler when clicking on gray canvas zones
        $("#posModalOverlay").on("click", function (e) {
            if ($(e.target).hasClass("pos-modal-overlay")) {
                fallbackToCashPayment();
            }
        });

        // Intercept keyboard event listeners globally across system execution
        $(document).on("keydown", function (e) {
            if (e.key === "Escape" && $("#posModalOverlay").hasClass("active")) {
                fallbackToCashPayment();
            }
        });

        function closeActivePOSModals() {
            $("#posModalOverlay").removeClass("active");
            $(".pos-modal-box").removeClass("active");
        }

        function fallbackToCashPayment() {
            closeActivePOSModals();
            // Reset state back to clean 'Cash' parameters automatically
            let cashRadio = $('input[name="paymentMethod"][value="Cash"]');
            cashRadio.prop("checked", true);
            resetHiddenPayloadFields();
            $("#hdnPaymentType").val("Cash");
        }
    });

    
</script>


