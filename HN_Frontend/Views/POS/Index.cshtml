        font-size: 14px; /* টেক্সট সাইজ ১ পিক্সেল কমানো হলো */
        letter-spacing: 0.5px;
    }

    .action-card-body {
        padding: 8px; /* ভেতরের মূল বডির প্যাডিং কমানো হলো যাতে বাটনগুলো গায়ে গায়ে লাগে */
        flex: 1;
        background: #f8fafc;
    }

    /* Custom Grid Matrix Allocation for Payment Channels */
    .payment-methods-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4px; /* পেমেন্ট বাটনগুলোর মাঝের গ্যাপ ৮ থেকে ৪ করা হলো (গায়ে গায়ে লাগবে) */
    }

        .payment-methods-grid label:nth-child(7) {
            grid-column: span 3; /* Extends Split Payment cleanly across full layout wide */
        }

    /* Custom Checkbox Design Mocking Radio Input Triggers */
    .method-option input[type="radio"] {
        display: none;
    }
    
    .method-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #334155;
        padding: 6px 5px;  
        border-radius: 4px;
        font-size: 14px; /* ফন্ট সাইজ সামান্য ছোট করা হলো */
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        user-select: none;
    }

        .method-btn i {
            font-size: 14px;
            color: #64748b; 
        }
    /* আইকন সাইজ ব্যালেন্স করা হলো */
    .method-option:hover .method-btn {
        background: #F6FBD2;
        border-color: #94a3b8;
    }

    /* Selected Button Highlights */
