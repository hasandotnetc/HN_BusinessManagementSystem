            // Since customerId is not saved in a dedicated input, we retrieve it from the UI selection
            // Tip: Ensure your autocompleter or initial load binds a reference attribute
            let customerId = $(".info-box .customer-card-content").parent().data("customer-id") || 0;
            // As a safe fallback, if no custom attribute is added yet, try to read or manage it globally
            // For standard setup, let's assume we read from a placeholder or default fallback
            let customerName = $(".info-box strong").first().text().trim();
                  

            if (!customerName) {
                Swal.fire({
                            icon: 'warning',
                            title: 'Empty Customer!',
                            text: 'Select a Customer first !',
                            confirmButtonColor: '#3085d6'
                        });
                        return;
            }

            // 3. Extract Sales Person Information
            let salesPersonName = $(".salesPerson-info-box strong").first().text().trim();

            // 4. Gather Payment Options & Totals
            let paymentMethod = $("#hdnPaymentType").val() || "Cash";
            let subTotal = parseFloat($("#lblSubTotal").text().replace(/,/g, '')) || 0;
            let discount = parseFloat($("#inputGlobalDiscount").val()) || 0;
            let tax = parseFloat($("#inputGlobalTax").val()) || 0;
            let grandTotal = parseFloat($("#lblGrandTotal").text().replace(/,/g, '')) || 0;
            let paidAmount = parseFloat($("#inputPaidAmount").val()) || 0;
            let dueAmount = parseFloat($("#lblDueAmount").val()) || 0;
            let changeAmount = parseFloat($("#lblChangeAmount").val()) || 0;

            // 5. Handle Split / Multi-Mode Payment Payload Data
            let splitPaymentsArray = [];
            if (paymentMethod === "Split") {
                let jsonPayloadRaw = $("#hdnSplitPaymentJsonPayload").val();
                if (jsonPayloadRaw) {
                    splitPaymentsArray = JSON.parse(jsonPayloadRaw);
                }
            }

            // 6. Build Consolidated Master Payload JSON Structure
            let masterSalePayload = {
                Customer: {
                    Name: customerName,
                    // Pass extra metadata if mapped to DOM attributes
                    Phone: $(".info-box .fa-phone").parent().text().trim()
                },
                SalesPerson: {
                    Name: salesPersonName
                },
                PaymentOption: {
                    Method: paymentMethod,
                    ReceiveAmount: paidAmount,
                    DueAmount: dueAmount,
                    ChangeAmount: changeAmount,
                    // Regular single payment details from hidden controls
                    MobileNo: $("#hdnMobileNo").val() || "",
                    CardNo: $("#hdnCardNo").val() || "",
                    ChequeNo: $("#hdnChequeNo").val() || "",
                    BankName: $("#hdnBankName").val() || ""
                },
                Summary: {
                    SubTotal: subTotal,
                    Discount: discount,
                    TaxPercent: tax,
                    GrandTotal: grandTotal
                },
                // Product List details mapping directly from memory array
                ProductRowsAllInfo: productCartList.map(item => ({
                    ProductId: item.id,
                    ProductName: item.name,
                    ProductCode: item.code,
                    SerialNo: item.serialNo,
                    Model: item.model,
                    UnitPrice: item.price,
                    Quantity: item.quantity,
                    RowDiscount: item.discount,
                    TotalPrice: (item.price * item.quantity) - item.discount
                })),
                // Holds due-split records if multi-mode split mechanism is verified
                SplitAmounts: splitPaymentsArray
            };

                console.log("masterSalePayload");
                console.log(masterSalePayload);

            // 7. Fire Async AJAX Dispatch Routine to Backend Controller Method
            $.ajax({
                url: "/POS/SaveInvoice", // Adjust the endpoint mapping to your actual backend controller routing
                type: "POST",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(masterSalePayload),
                beforeSend: function () {
                    // Disable button element to stop double-submission requests
                    $("#btnSaveInvoice").prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin"></i> Processing...');
                },
                 success: function (response) {
                if (response.success) {
                    let invoiceNo = response.invoiceNo || "INV-0001";
                    let salesOrderNo = response.salesOrderNo || "SO-0001";
                    let orderStatus = response.status || "Received";

                    let badgeHtml = `
                        <div class="pos-success-ribbon">
                            <div class="status-badge-circle">
                                <i class="fa-solid fa-circle-check"></i>
                                <span>${orderStatus}</span>
                            </div>
                            <div class="success-meta-details">
                                <span class="meta-label">Invoice No:</span>
                                <span class="meta-value">${invoiceNo}</span>
                    
                                <span class="meta-label">Order No:</span>
                                <span class="meta-value">${salesOrderNo}</span>
                            </div>
                        </div>
                    `;

                    // Safely push into the mid-section empty layout column
                    $("#posSuccessReceiptSpace").html(badgeHtml);

                       

                    if (typeof productCartList !== 'undefined') {
                        productCartList = []; 
                    }
                         Swal.fire({
                            icon: 'success', // 'successfull' er poriborte shudhu 'success' hobe
                            title: 'Saved Successfully',
                              html: `Invoice No: <strong>${invoiceNo}</strong><br/>Order No: <strong>${salesOrderNo}</strong>`,
                            confirmButtonColor: '#3085d6'
                        });
                        return;
                    // $("#btnClearCart").trigger("click");

                } else {
                    alert("Transaction Refused: " + response.message);
                }
            },
                // success: function (response) {
                //     if (response.success) {
                //         alert("Invoice compiled successfully! Invoice ID: " + (response.invoiceId || "N/A"));
                //         // Clear memory data node structures and wipe UI components back to default pristine settings
                //         $("#btnClearCart").trigger("click");
                //     } else {
                //         alert("Transaction Refused: " + response.message);
                //     }
                // },
                error: function (xhr, status, error) {
                    console.error("Critical error during backend save operations: ", xhr.responseText);
                    alert("An unexpected system fault occurred while attempting to post payload details.");
                },
                complete: function () {
                    // Re-enable interactive save functionality safely
                    // $("#btnSaveInvoice").prop("disabled", true).html('<i class="fa-solid fa-cloud-arrow-up"></i> Save');
                    $("#btnSaveInvoice").prop("disabled", true).css({"background-color": "#6c757d", "border-color": "#6c757d"}).html('<i class="fa-solid fa-cloud-arrow-up"></i> Saved');
                        // $("#btnSaveInvoice").prop("disabled", true).removeClass("btn-primary").addClass("btn-secondary").html('<i class="fa-solid fa-cloud-arrow-up"></i> Saved');
                }
            });
        });


            //


    });



    
        $("#btnClearCart").on("click", function () {
            window.location.reload();
           // window.location.href = '@Url.Action("Index", "POS")';
        });


</script>


