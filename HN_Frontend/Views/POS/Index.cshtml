function LoadCustomer(searchText = "Mr. Cash Sale") { 
$.ajax({
    url: "/Customer/GetCustomerByCodeNameAndPhone",
    type: "GET",
    data: { term: searchText }, 
    success: function (data) {
        console.log('Customer Loading');
        console.log(data); 
