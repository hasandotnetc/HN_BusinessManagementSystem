        /* Container Alignment */
.cart-empty-state-modern {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 260px;
    padding: 40px 20px;
    text-align: center;
    background: radial-gradient(circle at center, #ffffff 0%, #f8fafc 100%);
    animation: fadeInContainer 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Smooth fade-in for the whole container view */
@@keyframes fadeInContainer {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Core Animation Wrapper */
.animation-wrapper {
    position: relative;
    width: 100px;
    height: 100px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Floating Icon Box */
.cart-icon-box {
    position: relative;
    width: 76px;
    height: 76px;
    background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
    color: #4f46e5; /* Premium Indigo Accent */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.2);
    z-index: 2;
    animation: floatingCart 3s ease-in-out infinite;
}

/* Radar Pulse Rings */
.radar-pulse {
    position: absolute;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: rgba(79, 70, 229, 0.15);
    z-index: 1;
    animation: radarExpand 3s cubic-bezier(0.25, 0, 0, 1) infinite;
}

/* Typography Enhancements */
.empty-title {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
}

.empty-subtitle {
    font-size: 13px;
    color: #64748b;
    max-width: 300px;
    margin: 0 0 20px 0;
    line-height: 1.5;
}

/* Dynamic Direction Indicator */
.direction-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f1f5f9;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    border: 1px solid #e2e8f0;
}

.direction-indicator i {
    animation: pointLeft 1.5s ease-in-out infinite;
}

/* Keyframe Definitions */
    @@keyframes floatingCart {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@keyframes radarExpand {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        100% {
            transform: scale(1.8);
            opacity: 0;
        }
    }

    @@keyframes pointLeft {
        0%, 100% {
            transform: translateX(0);
        }

        50% {
            transform: translateX(-4px);
        }
    }







    /*--------------------- Modern Toast Notification Container Start ---------------- */
    #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* Toast Body */
    .pos-toast {
        background: #ffffff;
        border-left: 4px solid #ef4444; /* Dark red warning edge */
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
        padding: 12px 16px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 300px;
        max-width: 450px;
        animation: toastSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        transition: all 0.3s ease;
    }

    /* Warning Message Text Details */
    .toast-content {
        flex: 1;
    }

    .toast-title {
        font-weight: 700;
        font-size: 14px;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .toast-message {
        font-size: 13px;
        color: red;
        line-height: 1.4;
    }

    /* Toast Icon Wrapper */
    .toast-icon {
        font-size: 18px;
        color: #ef4444;
    }

    /* Slide in animation track */
    @@keyframes toastSlideIn {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* Fade out style applied via JavaScript */
    .toast-fade-out {
        transform: translateX(120%);
        opacity: 0;
        pointer-events: none;
    } 
    /*--------------------- Modern Toast Notification Container End ---------------- */




