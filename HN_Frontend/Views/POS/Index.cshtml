});
}
     
function RenderCustomer(c) { 
    const imageHtml = c.picture
        ? `<img src="${c.picture}" alt="${c.name}" class="cust-avatar">`
        : `<div class="cust-avatar-fallback"><i class="fa-solid fa-user"></i></div>`; 
        const html = `
            <div class="customer-card-content">
                ${imageHtml}
                <div class="cust-details">
                    <div class="cust-name-row">
                        <strong>${c.name}</strong>
                    </div>
                    <div style="font-size: 12px; margin-right: 5px;">
                        <i class="fa-solid fa-phone"></i> ${c.phone || 'N/A'}
                    </div>
                    <div class="cust-code">Code: ${c.code}</div>
                </div> 
                <div class="cust-totals">
                    <div>Total Sales: <strong>${(c.totalSales || 0).toLocaleString()}</strong></div>
                    <div>Total Due: <strong style="color:red;">${(c.dueAmount || 0).toLocaleString()}</strong></div>
                </div> 
                <span class="close-btn" onclick="$(this).parent().remove()">✕</span>
            </div>`;
        $(".info-box").html(html);
    };
     
$("#btnSearchCustomer").autocomplete({
            source: function (request, response) {
                $.get("/Customer/GetCustomerByCodeNameAndPhone",
                    { term: request.term },
                    function (data) {
                            console.log(data);
                        response($.map(data, function (item) {
                            return { 
                                label: "👤 "+ item.name + " 🖁" + item.phone ,
                                value: "👤 "+ item.name +" 🖁"+ item.phone,
                            // Pass all data fields to ui.item
                                id: item.customerId,
                                name: item.name,
                                phone: item.phone,
                                code: item.code,
                                totalSales: item.totalSales,
                                dueAmount: item.dueAmount,
                                picture: item.picture  
                            };
                        }));
                    });
            }, 
            minLength: 2,
            select: function (event, ui) {
            const c = ui.item;
                RenderCustomer(c); 
            return false;  
        }
