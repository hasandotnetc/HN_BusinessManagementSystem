<script>
        const API_BASE_URL = "https://localhost:7008/api";

        const IMAGE_BASE_URL = "https://localhost:7008/";

        const DEFAULT_IMAGE = `${IMAGE_BASE_URL}/Upload/Product/no-image.png`;
        console.log(DEFAULT_IMAGE);

           function getImageUrl(path) {
            console.log('getImageUrl');
            console.log(path);
            if (!path || path.trim() === "")
                return DEFAULT_IMAGE;
            console.log(DEFAULT_IMAGE);

            return IMAGE_BASE_URL + path;
        }
         

    //------------ Product Information Script Start------------//
    $(function () {
        LoadProducts();
        let typingTimer;    //Timer set cause database traffic handle.

        $("#btnSearchProduct").on("input", function () {
            clearTimeout(typingTimer);
            let keyword = $(this).val();
            typingTimer = setTimeout(function () {
                    LoadProducts(keyword);
            }, 500);
        });

    function LoadProducts(searchText = "a") {
        $.ajax({
            url: `${API_BASE_URL}/SearchingByDapper/GetProductByNameCodeModelNoWithCurrentStock`,
            type: "GET",
            data: {
                paramObj: searchText.trim()
            },
            success: function (data) {
                let html = "";

                if (!data || data.length === 0) {
                    $(".productInfo-box").html(`
                        <div class="empty-state">
                            <i class="fa-solid fa-box-open"></i>
                            <div>No Product Found</div>
                        </div>`);
                    return;
                }

                data.forEach(function (p) {
                    // const imageHtml = p.picture
                    //     ? `<img src="${p.picture}" class="product-image" alt="${p.name}">`
                    //     : `<div class="product-image-placeholder"><i class="fa-solid fa-box"></i></div>`;

                    html += `<div class="product-item">
                                <div class="product-left">
                                  
                                


                                    <div class="product-details">
                                        <span class="product-name">
                                            ${p.name || ''}
                                        </span>
                                        <span class="product-subtext">
                                            Code: ${p.code || 'N/A'} |
                                            ${p.serialNo ? `#SL: ${p.serialNo}` : `Model: ${p.model || 'N/A'}`}
                                        </span>
                                    </div>
                                </div>
                                <div class="product-right">
                                    <div>
                                        Price: <strong>${(p.price || 0).toLocaleString()}</strong>
                                    </div>
                                    <div>
                                        Stock: <strong style="color:#dc3545">${(p.quantity || 0).toLocaleString()}</strong>
                                    </div>
                                </div>
                                <button class="btn-add-cart add-product-in-grid"
                                        data-id="${p.productId}"
                                        data-name="${p.name}">
                                        <i class="fa-solid fa-cart-plus"></i>
                                </button>
                            </div>`;
                });

                $(".productInfo-box").html(html);
            },
            error: function (err) {
                console.error("API Fetch Error:", err);
                $(".productInfo-box").html(`
                    <div class="empty-state">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <div>Failed To Load Products</div>
                    </div>`);
            }
        });
    }
        $(document).on("click", ".btn-add-cart", function () {

            const productId = $(this).data("id");
            const productName = $(this).data("name");

            // console.log("Selected Product ID:", productId);
            // console.log("Selected Product:", productName);

            $(this).blur();
        });

    });
    //------------ Product Information Script End ------------//




    //------------- Customer Information Script Start ---------//
    $(document).ready(function(){
        LoadSalesPerson();
        LoadSupplier();
    })

    function LoadSupplier(searchText = "VendorSupplier") {
        // alert('hasan here you are.');
        $.ajax({
            // url: `${API_BASE_URL}/Supplier/GetSupplierByNameCodePhone/${encodeURIComponent(searchText)}`,
            url: `${API_BASE_URL}/Supplier/GetSupplierByNameCodePhone`,
            type: "GET",
            data: {
                objParam: searchText
            }, 
            success: function (data) {
                if (!data || data.length === 0) {
                    $(".info-box").html(`
                        <div class="empty-state">
                            <i class="fa-solid fa-user-slash"></i>
                            <div>No Supplier Found</div>
                        </div>
                    `);
                    return;
                }

                SetSupplierInformationInCart(data[0]);
            }
            ,error: function (err) {
            console.log(err);
            $(".info-box").html(`
                <div class="empty-state">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>Failed To Load Supplier</div>
                </div>
            `);
            }
        }) 
    }


        function SetSupplierInformationInCart(supplier) {

            console.log('supplier');
            console.log(supplier);

            // const imageHtml = supplier.picture
            //     ? `<img src="${supplier.picture}" alt="${supplier.name}" class="cust-avatar">`
            //     : `<div class="cust-avatar-fallback"><i class="fa-solid fa-user"></i></div>`;
                 
            const html = `
                <div class="customer-card-content" data-id="${supplier.supplierId || 0}">
                     
                <img src="${getImageUrl(supplier.picture)}"
                     width="50"
                     height="50"
                     class="rounded border"
                     style="object-fit: cover;"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='${DEFAULT_IMAGE}'">
 

                    <div class="cust-details">
                        <div class="cust-name-row">
                            <strong>${supplier.name}</strong>
                        </div>
                        <div style="font-size: 12px; margin-right: 5px;">
                            <i class="fa-solid fa-phone"></i> ${supplier.phone || 'N/A'}
                        </div>
                        <div class="cust-code">Code: ${supplier.code}</div>
                    </div>
                    
                </div>`;
            $(".info-box").html(html);
        }

    $("#btnSearchSupplier").autocomplete({
        source: function (request, response) {

            $.ajax({
                url: `${API_BASE_URL}/Supplier/GetSupplierByNameCodePhone`,
                type: "GET",
                data: {
                    objParam: request.term
                },
                success: function (data) {
                    console.log(data);
                    response($.map(data, function (item) {
                        return {
                            label: `👤 ${item.name} 🖁 ${item.phone}`,
                            value: `👤 ${item.name} 🖁 ${item.phone}`,

                            // Custom properties
                            id: item.supplierId,
                            name: item.name,
                            phone: item.phone,
                            code: item.code,
                            // totalSales: item.totalSales,
                            // dueAmount: item.dueAmount,
                            picture: item.picture
                        };
                    }));
                },
                error: function (xhr) {
                    console.error(xhr);
                    response([]);
                }
            });

        },
        minLength: 2,
        select: function (event, ui) {
            SetSupplierInformationInCart(ui.item);
            return false;
        }
    });

    //------------- Customer Information Script End ---------//

     


        $("#btnSearchSalesPerson").autocomplete({
                    source: function (request, response) {
                            $.get("/Employee/GetEmployeeByCodeNameAndPhone",
                            { term: request.term },
                            function (data) {
                                    console.log('data employee');
                                    console.log(data);
                                response($.map(data, function (item) {
                                    return {
                                        label: "👤 "+ item.name + " 🖁" + item.phone ,
                                        value: "👤 "+ item.name +" 🖁"+ item.phone,
                                    // Pass all data fields to ui.item
                                        id: item.employeeId,
                                        name: item.name,
                                        phone: item.phone,
                                        code: item.code,
                                        // totalSales: item.totalSales,
                                        // dueAmount: item.dueAmount,
                                        picture: item.picture
                                    };
                                }));
                            });
                    },
                    minLength: 2,
                    select: function (event, ui) {
                    const p = ui.item;
                    console.log(p);
                         RenderSalesPerson(p);
                    return false;
                }
                });


                    function RenderSalesPerson(p) {
            const imageHtml = p.picture
                ? `<img src="${p.picture}" alt="${p.name}" class="cust-avatar">`
                : `<div class="cust-avatar-fallback"><i class="fa-solid fa-user"></i></div>`;

            // 1. Fixed data-employeeid attribute name to lowercase
            // 2. Changed 'c.employeeId' to 'p.id' or 'p.employeeId' based on your payload object
            const html = `
                <div class="customer-card-content" data-employeeid="${p.id || p.employeeId || 0}">
                    ${imageHtml}
                    <div class="cust-details">
                        <div class="cust-name-row">
                            <strong>${p.name}</strong>
                        </div>
                        <div style="font-size: 12px; margin-right: 5px;">
                            <i class="fa-solid fa-phone"></i> ${p.phone || 'N/A'}
                        </div>
                        <div class="cust-code">Code: ${p.code}</div>
                    </div>
                </div>`;
            $(".salesPerson-info-box").html(html);
        };
         

            function LoadSalesPerson(searchText = "ADMIN") {
        $.ajax({
                url: "/Employee/GetEmployeeByCodeNameAndPhone",
            type: "GET",
            data: { term: searchText },
            success: function (data) {
                // console.log('Employee Loading');
                // console.log(data);
                if (!data || data.length === 0) {
                    $(".salesPerson-info-box").html(`
                        <div class="empty-state">
                            <i class="fa-solid fa-user-slash"></i>
                            <div>No Employee Found</div>
                        </div>
                    `);
                    return;
                }
                    RenderSalesPerson(data[0]);
            },

            error: function (err) {
                console.log(err);
                $(".salesPerson-info-box").html(`
                    <div class="empty-state">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <div>Failed To Load Sales Person</div>
                    </div>
                `);
            }
        });
        }

         
         
</script>
