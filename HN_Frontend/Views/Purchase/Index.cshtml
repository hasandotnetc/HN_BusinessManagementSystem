@{
    ViewData["Title"] = "Purchase Order System";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #7547A3;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 6px;
        overflow-x: hidden;
    }

    .pos-container {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 75px);
    }

    /* CARD STYLING */
    .card, .product-card, .action-card {
        background: #fff;
        border-radius: 8px;
        margin-bottom: 6px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        border: 1px solid #e2e8f0;
    }

    .card-header, .product-card-header, .action-card-header {
        padding: 6px 12px;
        font-weight: 600;
        color: #ffffff;
        background-color: rebeccapurple;
        font-size: 13px;
        letter-spacing: 0.5px;
    }

    .card-body, .product-card-body, .action-card-body {
        padding: 8px;
    }

    input, textarea, select {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* SEARCH HEADER & INPUTS */
    .search-header {
        display: flex;
        gap: 8px;
        margin-bottom: 6px;
    }

    .btn-new {
        width: 100%;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: rebeccapurple;
        border: 1px solid rebeccapurple;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-new:hover {
            background-color: rebeccapurple;
            color: white;
        }

    .info-box, .salesPerson-info-box {
        min-height: 55px;
        border: 1px dashed #cbd5e1;
        padding: 6px;
        border-radius: 6px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* LEFT SIDE FLEX CONTAINER */
    .left-panel-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 320px;
    }

    .product-card-body {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* PRODUCT SCROLL CONTAINER */
    .product-scroll-container {
        flex: 1;
        max-height: 380px;
        min-height: 220px;
        overflow-y: auto;
        overflow-x: hidden;
        border-top: 1px solid #f2f2f2;
    }

        .product-scroll-container::-webkit-scrollbar {
            width: 5px;
        }

        .product-scroll-container::-webkit-scrollbar-thumb {
            background: #d3cfde;
            border-radius: 5px;
        }

    .product-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 8px;
        border-bottom: 1px solid #f3f3f3;
        transition: 0.2s;
        cursor: pointer;
    }

        .product-item:hover {
            background: #faf7ff;
        }

    .product-left {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 70%;
    }

    .product-image-placeholder, .cust-avatar-fallback {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        background: #ececec;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #888;
        flex-shrink: 0;
    }

    .product-details {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .product-name {
        font-size: 12px;
        font-weight: 600;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .product-subtext {
        font-size: 11px;
        color: #777;
    }

    .product-right {
        text-align: right;
        margin-right: 8px;
        font-size: 11px;
    }

    .btn-add-cart {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 50%;
        background: #28a745;
        color: white;
        cursor: pointer;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background 0.2s;
    }

        .btn-add-cart:hover {
            background: #1f8a37;
        }

    /* RIGHT PANEL FLEX CONTAINER */
    .right-panel-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* PURCHASE INFORMATION HEADER CARD */
    .purchase-header-card {
        background: #ffffff;
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 6px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .purchase-header-form {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .purchase-field-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

        .purchase-field-group label {
            font-size: 12px;
            font-weight: 700;
            color: #334155;
            white-space: nowrap;
        }

        .purchase-field-group input {
            width: 100%;
            height: 30px;
            padding: 4px 8px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid #cbd5e1;
            border-radius: 5px;
            color: #1e293b;
        }

            .purchase-field-group input[readonly] {
                background-color: #f1f5f9;
                cursor: not-allowed;
            }

    /* EXPANDED PURCHASE CART GRID */
    .pos-cart-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 380px;
        border: 1px solid #e2e8f0;
        margin-bottom: 6px;
    }

    .pos-cart-header {
        display: flex;
        background: rebeccapurple;
        color: #ffffff;
        font-weight: 600;
        padding: 6px 4px;
        font-size: 12px;
    }

    .header-cell {
        padding: 0 4px;
    }

    .col-sl {
        width: 6%;
        text-align: center;
    }

    .col-product {
        width: 31%;
    }

    .col-serial {
        width: 14%;
        text-align: center;
    }

    .col-price {
        width: 14%;
    }

    .col-qty {
        width: 11%;
    }

    .col-discount {
        width: 10%;
    }

    .col-total {
        width: 10%;
        text-align: right;
        padding-right: 8px;
    }

    .col-delete {
        width: 4%;
        text-align: center;
    }

    .pos-cart-body {
        flex: 1;
        overflow-y: auto;
        background: #f8fafc;
        min-height: 180px;
    }

    .cart-item-row {
        display: flex;
        align-items: center;
        padding: 6px 4px;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
        transition: background 0.2s;
    }

        .cart-item-row:hover {
            background: #f1f5f9;
        }

    .btn-serial-trigger {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #86efac;
        padding: 3px 6px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-serial-trigger.not-serialized {
            background: #f1f5f9;
            color: #94a3b8;
            border-color: #cbd5e1;
            cursor: not-allowed;
        }

    .cart-grid-input {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        padding: 3px 5px;
        font-size: 12px;
        font-weight: 600;
        text-align: center;
        color: #334155;
    }

        .cart-grid-input:focus {
            outline: none;
            border-color: rebeccapurple;
            box-shadow: 0 0 0 2px rgba(102, 51, 153, 0.15);
        }

    .btn-cart-delete {
        background: none;
        border: none;
        color: #ef4444;
        cursor: pointer;
        font-size: 14px;
    }

    /* FOOTER AND SUMMARY */
    .pos-cart-footer {
        background: #ffffff;
        border-top: 2px solid #cbd5e1;
        padding: 6px 10px;
    }

    .footer-summary-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        width: 100%;
    }

    .payment-box, .summary-box {
        width: 250px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        border: 1px solid #e2e8f0;
        padding: 6px 8px;
        border-radius: 6px;
        background: #fafafa;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #475569;
    }

    .payment-label {
        font-weight: 700;
        font-size: 12px;
        color: #1e293b;
    }

    .payment-input, .summary-input {
        width: 90px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        text-align: right !important;
        padding: 2px 5px !important;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
    }

    #lblDueAmount[readonly] {
        background-color: #FEE9DA;
        color: #0f172a;
        cursor: not-allowed;
    }

        #lblDueAmount[readonly].due-clear-green {
            background-color: #d1fae5 !important;
            color: #065f46 !important;
            border-color: #a7f3d0 !important;
        }

    .grand-total-highlight {
        border-top: 1px dashed #cbd5e1;
        padding-top: 4px;
        margin-top: 2px;
        font-weight: 800;
    }

        .grand-total-highlight .label {
            color: rebeccapurple;
        }

        .grand-total-highlight .value {
            color: rebeccapurple;
            font-size: 15px;
        }

    /* EXPANDED EMPTY CART STATE */
    .cart-empty-state-modern {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 180px;
        padding: 20px;
        text-align: center;
    }

    .cart-icon-box {
        width: 55px;
        height: 55px;
        background: #f3e8ff;
        color: rebeccapurple;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 10px;
    }

    .empty-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .empty-subtitle {
        font-size: 12px;
        color: #64748b;
    }

    /* ACTION & PAYMENT PANELS AT BOTTOM */
    .pos-actions-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
    }

    .method-card {
        width: 55%;
        margin-bottom: 0;
    }

    .operational-card {
        width: 45%;
        margin-bottom: 0;
    }

    .payment-methods-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }

    .method-option input[type="radio"] {
        display: none;
    }

    .method-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #334155;
        padding: 6px 4px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

    .method-option input[type="radio"]:checked + .method-btn {
        background: #f3e8ff;
        border-color: rebeccapurple;
        color: rebeccapurple;
    }

    .process-buttons-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }

    .btn-op {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: none;
        padding: 6px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        color: #ffffff;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .btn-op:hover {
            opacity: 0.9;
        }

    .btn-op-save {
        background: rebeccapurple;
    }

    .btn-op-hold {
        background: #d97706;
    }

    .btn-op-clear {
        background: #ef4444;
    }

    .btn-op-print {
        background: #0284c7;
    }

    .btn-op-quote {
        background: #4b5563;
    }

    .btn-op-discount {
        background: #059669;
    }

    /* MODAL OVERLAYS */
    .pos-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(3px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        visibility: hidden;
        opacity: 0;
        transition: all 0.2s ease;
    }

        .pos-modal-overlay.active {
            visibility: visible;
            opacity: 1;
        }

    .pos-modal-box {
        background: #ffffff;
        border-radius: 8px;
        width: 450px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        display: none;
    }

    .pos-modal-overlay.active .pos-modal-box.active {
        display: block;
    }

    .pos-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: rebeccapurple;
        color: white;
        border-radius: 8px 8px 0 0;
    }

        .pos-modal-header h4 {
            font-size: 14px;
            margin: 0;
            font-weight: 600;
        }

    .btn-modal-close {
        background: none;
        border: none;
        font-size: 18px;
        color: white;
        cursor: pointer;
    }

    .pos-modal-body {
        padding: 12px;
    }

    .serial-type-selector {
        display: flex;
        gap: 15px;
        margin-bottom: 10px;
        padding-bottom: 8px;
        border-bottom: 1px dashed #cbd5e1;
    }

    .serial-badge-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        padding: 2px 6px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

        .serial-badge-tag .btn-remove-tag {
            color: #ef4444;
            cursor: pointer;
        }

    .customer-card-content {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        position: relative;
        background: #f9f9f9;
        width: 100%;
    }

    .cust-details {
        flex-grow: 1;
    }

    .cust-name-row {
        font-size: 12px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .cust-code {
        font-size: 10px;
        color: #777;
    }

    .close-btn {
        position: absolute;
        top: 3px;
        right: 8px;
        cursor: pointer;
        color: red;
        font-size: 12px;
    }

    @@media (max-width: 991px) {
        .pos-container {
            height: auto;
        }

        .method-card, .operational-card {
            width: 100%;
        }

        .pos-actions-row {
            flex-direction: column;
        }

        .footer-summary-wrapper {
            flex-direction: column;
        }

        .payment-box, .summary-box {
            width: 100%;
        }
    }
</style>

<!-- Standardized jQuery & jQuery UI Loading Sequence -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

<div class="pos-container">
    <div class="row g-2 flex-grow-1">
        <!-- LEFT PANEL -->
        <div class="col-12 col-lg-4">
            <div class="left-panel-wrapper">

                <!-- SUPPLIER INFORMATION CARD -->
                <div class="card">
                    <div class="card-header">
                        <i class="fa-solid fa-truck-field"></i> Supplier Information
                    </div>
                    <div class="card-body">
                        <div style="display:flex; width:100%; gap:6px; align-items: center; margin-bottom:6px;">
                            <div style="width:80%;">
                                <input type="text" id="btnSearchSupplier" placeholder=" 🔍 Search Supplier by Name/Phone"
                                       style="width:100%; height: 30px; padding: 4px 8px; font-size:12px; border:1px solid #ccc; border-radius:4px;">
                            </div>
                            <div style="width:20%;">
                                <input type="button" id="btnAddSupplier" value="+ New" class="btn-new">
                            </div>
                        </div>
                        <div class="info-box" id="supplierInfoBox">
                            <span style="font-size:11px; color:#94a3b8;">Search and select a supplier</span>
                        </div>
                    </div>
                </div>

                <!-- EXPANDED PRODUCT CATALOG CARD -->
                <div class="product-card">
                    <div class="product-card-header">
                        <i class="fa-solid fa-cube"></i> Product Catalog
                    </div>
                    <div class="product-card-body">
                        <div class="search-header">
                            <div style="width:80%;">
                                <input type="text" id="btnSearchProduct" placeholder=" 🔍 Search by Name, Code, Model"
                                       style="width:100%; height: 30px; padding: 4px 8px; font-size:12px; border:1px solid #ccc; border-radius:4px;">
                            </div>
                            <div style="width:20%;">
                                <input type="button" id="btnAddProduct" value="+ New" class="btn-new">
                            </div>
                        </div>

                        <div class="product-scroll-container">
                            <div class="productInfo-box" id="productCatalogList">
                                <!-- Dynamic Products List -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EMPLOYEE INFORMATION CARD -->
                <div class="card" style="margin-bottom:0;">
                    <div class="card-header">
                        <i class="fa-solid fa-user-tie"></i> Employee / Purchaser
                    </div>
                    <div class="card-body">
                        <div style="display:flex; width:100%; gap:6px; align-items: center; margin-bottom:6px;">
                            <div style="width:80%;">
                                <input type="text" id="txtSearchEmployee" placeholder=" 🔍 Search Employee by Name/Phone"
                                       style="width:100%; height: 30px; padding: 4px 8px; font-size:12px; border:1px solid #ccc; border-radius:4px;">
                            </div>
                            <div style="width:20%;">
                                <input type="button" id="btnAddEmployee" value="+ New" class="btn-new">
                            </div>
                        </div>
                        <div class="salesPerson-info-box" id="employeeInfoBox">
                            <span style="font-size:11px; color:#94a3b8;">Search and select an employee</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="col-12 col-lg-8">
            <div class="right-panel-wrapper">

                <!-- HEADER DETAILS -->
                <div class="purchase-header-card">
                    <div class="purchase-header-form">
                        <div class="purchase-field-group">
                            <label><i class="fa-solid fa-calendar-days" style="color:rebeccapurple;"></i> Purchase Date:</label>
                            <input type="date" id="txtPurchaseDate">
                        </div>
                        <div class="purchase-field-group">
                            <label><i class="fa-solid fa-hashtag" style="color:rebeccapurple;"></i> Purchase No:</label>
                            <input type="text" id="txtPurchaseNo" placeholder="Auto Generated" disabled>
                        </div>
                    </div>
                </div>

                <!-- MAIN EXPANDED PURCHASE CART GRID -->
                <div class="pos-cart-card">
                    <div class="pos-cart-header">
                        <div class="header-cell col-sl">#SL</div>
                        <div class="header-cell col-product">Item / Details</div>
                        <div class="header-cell col-serial">Serial No</div>
                        <div class="header-cell col-price">Cost Price</div>
                        <div class="header-cell col-qty">Quantity</div>
                        <div class="header-cell col-discount">Discount</div>
                        <div class="header-cell col-total">Total</div>
                        <div class="header-cell col-delete">Del</div>
                    </div>

                    <div class="pos-cart-body" id="cartItemsContainer">
                        <!-- Dynamic Purchase Cart Rows -->
                    </div>

                    <!-- FOOTER SUMMARY & CALCULATIONS -->
                    <div class="pos-cart-footer">
                        <div class="footer-summary-wrapper">
                            <div class="payment-box">
                                <div class="summary-item">
                                    <span class="label payment-label">Paid Amount</span>
                                    <input type="number" class="summary-input payment-input" id="inputPaidAmount" min="0" step="any">
                                </div>
                                <div class="summary-item">
                                    <span class="label payment-label">Due Amount</span>
                                    <input class="summary-input payment-input" id="lblDueAmount" value="0.00" readonly>
                                </div>
                                <div class="summary-item">
                                    <span class="label payment-label">Change Amount</span>
                                    <input class="summary-input payment-input" id="lblChangeAmount" value="0.00" readonly>
                                </div>
                            </div>

                            <div id="purchaseReceiptSpace" style="flex: 1;"></div>

                            <div class="summary-box">
                                <div class="summary-item">
                                    <span class="label">Sub Total</span>
                                    <span class="value" id="lblSubTotal">0.00</span>
                                </div>
                                <div class="summary-item">
                                    <span class="label">Discount</span>
                                    <input type="number" class="summary-input" id="inputGlobalDiscount" value="0" min="0">
                                </div>
                                <div class="summary-item">
                                    <span class="label">Tax (%)</span>
                                    <input type="number" class="summary-input" id="inputGlobalTax" value="0" min="0">
                                </div>
                                <div class="summary-item grand-total-highlight">
                                    <span class="label">Grand Total</span>
                                    <span class="value" id="lblGrandTotal">0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PAYMENT & ACTION PROCESS PANEL -->
                <div class="pos-actions-row">
                    <!-- ALL PAYMENT METHODS -->
                    <div class="action-card method-card">
                        <div class="action-card-header">
                            <i class="fa-solid fa-wallet"></i> Payment Method
                        </div>
                        <div class="action-card-body payment-methods-grid">
                            <label class="method-option">
