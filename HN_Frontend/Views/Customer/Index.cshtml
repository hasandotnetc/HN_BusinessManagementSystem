@{
    ViewData["Title"] = "Customer Setup";
}

<!-- GOOGLE FONTS, BOOTSTRAP ICONS, TOASTR & NOTYF -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<style>
    :root {
        /* Primary Brand Palette (Matching Product Setup) */
        --rebecca-solid: #663399; /* RebeccaPurple */
        --rebecca-dark: #4b2375; /* Darker Purple Hover */
        --rebecca-gold: #e0aa3e; /* Action Accent Gold */
        --rebecca-gold-hover: #cc962d; /* Accent Gold Hover */
        --rebecca-light-bg: #f3f4f6; /* Soft Workspace Background */
        --rebecca-card-bg: #ffffff; /* Premium White Container Surface */
        --rebecca-border: #e5e7eb; /* Subtle Light Dividers */
        /* Typography Colors */
        --text-dark: #1f2937; /* Crisp Dark Text */
        --text-muted: #6b7280; /* Secondary Label Text */
    }

    /* Base Layout Container */
    .customer-workspace-wrapper {
        background-color: var(--rebecca-light-bg);
        color: var(--text-dark);
        border-radius: 8px;
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.8125rem;
    }

    /* Premium White Cards */
    .form-card-premium {
        background-color: var(--rebecca-card-bg) !important;
        border: 1px solid var(--rebecca-border);
        border-radius: 8px;
        padding: 16px !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
    }

    /* Solid Purple Header Bar */
    .section-header-banner {
        background-color: var(--rebecca-solid);
        color: #ffffff;
        padding: 8px 14px;
        border-radius: 6px;
        margin-bottom: 16px;
    }

    .section-title-White {
        color: #ffffff;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.5px;
    }

    /* Labels & Controls */
    .inline-label {
        color: #374151;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        min-width: 95px;
        display: flex;
        align-items: center;
    }

    .custom-form-control {
        background-color: #ffffff !important;
        color: var(--text-dark) !important;
        border: 1px solid #d1d5db !important;
        border-radius: 4px !important;
        padding: 4px 8px;
        font-size: 12px;
        height: 28px !important;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .custom-form-control:focus {
            border-color: var(--rebecca-solid) !important;
            box-shadow: 0 0 0 2px rgba(102, 51, 153, 0.2) !important;
        }

        .custom-form-control[readonly] {
            background-color: #f1f5f9 !important;
            color: #64748b !important;
        }

    .mandatory-star {
        color: #dc2626;
        margin-left: 2px;
    }

    .row-aligned-checkbox {
        width: 15px;
        height: 15px;
        cursor: pointer;
        accent-color: var(--rebecca-solid);
    }

    /* Primary & Utility Buttons */
    .btn-gold-action {
        background-color: var(--rebecca-gold);
        color: #1a0f30 !important;
        font-weight: 700;
        border: none;
        padding: 5px 20px;
        border-radius: 4px;
        font-size: 12px;
        transition: background-color 0.2s ease;
    }

        .btn-gold-action:hover {
            background-color: var(--rebecca-gold-hover);
        }

    .btn-purple-utility {
        background-color: var(--rebecca-solid);
        color: #ffffff !important;
        border: none;
        border-radius: 4px;
        padding: 2px 12px;
        font-size: 11px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease;
    }

        .btn-purple-utility:hover {
            background-color: var(--rebecca-dark);
        }

    .btn-purple-outline {
        background-color: #ffffff;
        color: var(--rebecca-solid) !important;
        border: 1px solid var(--rebecca-solid);
        border-radius: 4px;
        padding: 2px 12px;
        font-size: 11px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .btn-purple-outline:hover {
            background-color: #f3e8ff;
        }

    /* SMART MODERN IMAGE UPLOADER DROPZONE */
    .uploader-box-smart {
        border: 2px dashed #cbd5e1;
        background-color: #fafafa;
        border-radius: 8px;
        cursor: pointer;
        height: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        transition: all 0.25s ease-in-out;
    }

        .uploader-box-smart:hover {
            border-color: var(--rebecca-solid);
            background-color: #f3e8ff;
            box-shadow: 0 4px 12px rgba(102, 51, 153, 0.08);
        }

        .uploader-box-smart .upload-icon-wrapper {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 6px;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .uploader-box-smart:hover .upload-icon-wrapper {
            transform: translateY(-2px);
            background: #ffffff;
        }

    /* Table & Container Styling */
    .premium-table-container {
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--rebecca-border);
        min-height: 220px;
        font-size: 12px;
        background-color: #ffffff;
    }

    .premium-data-table th {
        background-color: var(--rebecca-solid) !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 12px;
        padding: 8px 10px !important;
        border: none !important;
    }

    .premium-data-table td {
        background-color: transparent !important;
        color: var(--text-dark) !important;
        border-bottom: 1px solid var(--rebecca-border) !important;
        padding: 8px 10px !important;
    }

    .premium-data-table tbody tr:hover {
        background-color: #fafafa !important;
    }

    .btn-action-edit {
        background-color: var(--rebecca-gold);
        color: #1a0f30;
        font-weight: 600;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        border: none;
    }

        .btn-action-edit:hover {
            background-color: var(--rebecca-gold-hover);
        }

    /* Modal Backdrop Blur */
    .modal-backdrop.show {
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        background-color: rgba(15, 23, 42, 0.4);
    }
</style>

<div class="container-fluid p-2 customer-workspace-wrapper my-0">

    <!-- ================= ROW 1: CUSTOMER FORM SECTION ================= -->
    <div class="form-card-premium mb-3">
        <div class="section-header-banner d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-user-plus text-warning me-2" style="font-size: 13px;"></i>
                <h2 class="section-title-White m-0 text-uppercase tracking-wider">Customer Information</h2>
            </div>
            <span class="badge bg-white text-dark fw-semibold px-2 py-1" style="font-size: 11px;" id="formModeBadge">Create Mode</span>
        </div>

        <form id="customerSetupForm" enctype="multipart/form-data">
            <input type="hidden" id="CustomerId" name="CustomerId" value="0" />
            <input type="hidden" id="PicturePath" name="Picture" value="" />

            <div class="row g-3 align-items-start">

                <!-- COLUMN 1: Basic Info -->
                <div class="col-xl-3 col-md-6">
                    <!-- Customer Name -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="CustomerName">Name <span class="mandatory-star">*</span></label>
                        <input type="text" id="CustomerName" name="Name" class="form-control custom-form-control" placeholder="Enter customer name" required />
                    </div>

                    <!-- Code No -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="CustomerCode">Code No</label>
                        <input type="text" id="CustomerCode" name="Code" class="form-control custom-form-control" placeholder="Auto Generated" readonly />
                    </div>

                    <!-- Phone No -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="Phone">Phone No</label>
                        <input type="tel" id="Phone" name="Phone" class="form-control custom-form-control" placeholder="Phone number" />
                    </div>

                    <!-- Email -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="Email">Email</label>
                        <input type="email" id="Email" name="Email" class="form-control custom-form-control" placeholder="Email address" />
                    </div>
                </div>

                <!-- COLUMN 2: Address & Details -->
                <div class="col-xl-3 col-md-6">
                    <!-- Address -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="Address">Address <span class="mandatory-star">*</span></label>
                        <input type="text" id="Address" name="Address" class="form-control custom-form-control" placeholder="Customer address" required />
                    </div>

                    <!-- NID -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label" for="Nid">NID</label>
                        <input type="text" id="Nid" name="Nid" class="form-control custom-form-control" placeholder="NID number" />
                    </div>

                    <!-- Opening Balance -->
                    <div class="d-flex align-items-center mb-3" id="openingBalanceGroup">
                        <label class="inline-label" for="OpeningBalance">Opening Bal.</label>
                        <input type="number" step="0.01" id="OpeningBalance" name="OpeningBalance" class="form-control custom-form-control" value="0.00" />
                    </div>

                    <!-- Customer Group -->
                    <div class="d-flex align-items-center mb-3">
                        <label class="inline-label">Group <span class="mandatory-star">*</span></label>
                        <div class="d-flex gap-1 w-100">
                            <select id="CustomerGroupId" name="CustomerGroupId" class="form-select custom-form-control" required>
                                <option value="">-- Select Group --</option>
                            </select>
                            <button type="button" class="btn btn-purple-utility" onclick="openGroupModal()">
                                <i class="fa-solid fa-plus me-1"></i>New
                            </button>
                        </div>
                    </div>
                </div>

                <!-- COLUMN 3: Checkboxes & Status Options -->
                <div class="col-xl-3 col-md-6">
                    <div class="d-flex flex-column gap-2 pt-1 ps-2">
                        <div class="d-flex align-items-center gap-2">
                            <input class="row-aligned-checkbox" type="checkbox" id="ActiveStatus" name="ActiveStatus" checked />
                            <label class="form-check-label fw-semibold" for="ActiveStatus" style="font-size: 12px; color: #374151;">Active Status</label>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <input class="row-aligned-checkbox" type="checkbox" id="IsOwnCompanyCustomer" name="IsOwnCompanyCustomer" />
                            <label class="form-check-label fw-semibold" for="IsOwnCompanyCustomer" style="font-size: 12px; color: #374151;">Own Company Customer</label>
                        </div>

                        <div class="d-flex align-items-center gap-2" id="combineSupplierGroup">
                            <input class="row-aligned-checkbox" type="checkbox" id="CombineWithSupplier" name="CombineWithSupplier" />
                            <label class="form-check-label fw-semibold" for="CombineWithSupplier" style="font-size: 12px; color: #374151;">Combine With Supplier</label>
                        </div>
                    </div>
                </div>

                <!-- COLUMN 4: SMART MODERN IMAGE UPLOADER -->
                <div class="col-xl-3 col-md-6">
                    <label class="inline-label mb-1">Customer Photo</label>
                    <div class="uploader-box-smart" onclick="document.getElementById('CustomerImageInput').click();">
                        <input type="file" id="CustomerImageInput" accept="image/*" class="d-none" onchange="previewImage(this)" />

                        <div id="uploadPlaceholder" class="text-center p-2">
                            <div class="upload-icon-wrapper mx-auto">
                                <i class="fa-solid fa-cloud-arrow-up" style="font-size: 18px; color: var(--rebecca-solid);"></i>
                            </div>
                            <div class="fw-bold text-dark" style="font-size: 11px;">Upload Customer Photo</div>
                            <div style="font-size: 9px;" class="text-muted">PNG, JPG or WEBP up to 5MB</div>
                        </div>

                        <img id="imagePreview" class="w-100 h-100 object-fit-contain d-none rounded p-1" alt="Preview" />
                    </div>
                </div>

            </div>

            <!-- Form Action Footer -->
            <div class="d-flex justify-content-end align-items-center pt-2 mt-3 border-top gap-2">
                <button type="button" class="btn btn-purple-outline" onclick="resetForm()">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </button>
                <button type="submit" id="btnSave" class="btn btn-gold-action">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Customer
                </button>
            </div>
        </form>
    </div>

    <!-- ================= ROW 2: CUSTOMER LIST GRID CONTAINER ================= -->
    <div class="form-card-premium">
        <div class="section-header-banner d-flex align-items-center justify-content-between mb-0">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-users text-warning me-2" style="font-size: 13px;"></i>
                <h3 class="section-title-White m-0 text-uppercase tracking-wider" style="font-size: 14px;">All Customers List</h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group" style="max-width: 250px; height: 26px;">
                    <input type="text" id="searchInput" class="form-control bg-white text-dark py-0" placeholder="Search customer..." style="height:26px; font-size:11px;" onkeyup="fetchCustomerList()" />
                    <button class="btn btn-purple-utility px-2 py-0" type="button" style="height:26px;"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>
        </div>

        <div class="table-responsive premium-table-container position-relative">
            <table class="table premium-data-table align-middle m-0">
                <thead>
                    <tr>
                        <th width="40">#</th>
                        <th width="50">Image</th>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Phone</th>
                        <th>Group</th>
                        <th>Address</th>
                        <th width="80">Status</th>
                        <th width="80" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="customerListBody">
                    <!-- Dynamically Populated -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE GROUP MODAL -->
<div class="modal fade" id="groupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: var(--rebecca-solid);">
                <h6 class="modal-title fw-bold m-0" style="font-size:13px;">
                    <i class="fa-solid fa-folder-plus me-1"></i> Add Customer Group
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-2">
                    <label class="form-label fw-semibold mb-1" style="font-size: 11px;">Group Name <span class="mandatory-star">*</span></label>
                    <input type="text" id="newGroupName" class="form-control custom-form-control" placeholder="e.g. Retail, Wholesale" />
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-3 border-0">
                <button type="button" class="btn btn-purple-outline py-1 px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gold-action py-1 px-3" onclick="saveCustomerGroup()">Save Group</button>
            </div>
        </div>
    </div>
</div> 
<!-- SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
    toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "3000"
    };

    var API_HOST = (typeof APP_CONFIG !== 'undefined' && APP_CONFIG.API_BASE_URL) ? APP_CONFIG.API_BASE_URL : '';
    var DEFAULT_NO_IMAGE = API_HOST + "/Upload/Product/no-image.png";

    let isEditState = false;
    let modalInstance = null;
    let currentPage = 1;
    let pageSize = 10;
    let totalPages = 0;

    function getApiUrl(endpoint) {
        const baseUrl = (typeof APP_CONFIG !== 'undefined' && APP_CONFIG.API_BASE_URL) ? APP_CONFIG.API_BASE_URL : '';
        const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
        const cleanEndpoint = endpoint.startsWith('/') ? endpoint : `/${endpoint}`;
        return `${cleanBase}${cleanEndpoint}`;
    }

    function getAuthHeaders(contentType = 'application/json') {
        const jwtToken = (typeof getAuthCookie === 'function') ? getAuthCookie("HN_JWT") : (typeof token !== 'undefined' ? token : '');
        const headers = {
            'Authorization': jwtToken ? `Bearer ${jwtToken}` : ''
        };
        if (contentType) {
            headers['Content-Type'] = contentType;
        }
        return headers;
    }

    document.addEventListener("DOMContentLoaded", function () {
        modalInstance = new bootstrap.Modal(document.getElementById('groupModal'));
        setDefaultImage();
        loadCustomerGroups();
        fetchCustomerList();

        document.getElementById('customerSetupForm').addEventListener('submit', handleFormSubmit);

        // Delegated Event Listener for Edit Button
        $(document).on('click', '.btn-edit-customer', function () {
            const customerData = $(this).data('customer');

            console.log('customerDatacustomerDatacustomerData');
            console.log(customerData);

            if (customerData) {
                editCustomer(customerData);
            }
        });
    });

    function setDefaultImage() {
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('uploadPlaceholder');
        if (preview && placeholder) {
            preview.src = "";
            preview.classList.add('d-none');
            placeholder.classList.remove('d-none');
        }
    }

    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('uploadPlaceholder');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    async function safeJsonParse(response) {
        if (!response.ok) return null;
        const text = await response.text();
        return text ? JSON.parse(text) : null;
    }

    async function loadCustomerGroups(selectedId = null) {
        try {
            const response = await fetch(getApiUrl('/api/CustomerGroup/GetCustomerGroupDropdown'), {
                method: 'GET',
                headers: getAuthHeaders('application/json')
            });

            const data = await safeJsonParse(response) || [];

            const dropdown = document.getElementById('CustomerGroupId');
            dropdown.innerHTML = '<option value="">-- Select Group --</option>';

            data.forEach(item => {
                const option = document.createElement('option');
                option.value = item.customerGroupId;
                option.textContent = item.name;
                dropdown.appendChild(option);
            });

            if (selectedId) dropdown.value = selectedId;
        } catch (err) {
            toastr.error("Failed to load customer groups.");
        }
    }

    function openGroupModal() {
        document.getElementById('newGroupName').value = '';
        modalInstance.show();
    }

    async function saveCustomerGroup() {
        const name = document.getElementById('newGroupName').value.trim();
        if (!name) {
            toastr.warning("Please enter a group name.");
            return;
        }

        const payload = {
            name: name,
            code: "",
            companyId: 1,
            entryBy: 1,
            createOn: new Date().toISOString()
        };

        try {
            const response = await fetch(getApiUrl('/api/CustomerGroup/CreateCustomerGroup'), {
                method: 'POST',
                headers: getAuthHeaders('application/json'),
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                const resData = await safeJsonParse(response);
                modalInstance.hide();
                toastr.success("Customer Group created successfully!");
                await loadCustomerGroups(resData?.data?.customerGroupId || null);
            } else {
                toastr.error("Failed to save Customer Group.");
            }
        } catch (err) {
            toastr.error("An error occurred while saving group.");
        }
    }

    async function handleFormSubmit(e) {
        e.preventDefault();

        const formData = new FormData();
        const fileInput = document.getElementById('CustomerImageInput');

        formData.append("Name", document.getElementById('CustomerName').value);
        formData.append("Phone", document.getElementById('Phone').value || "");
        formData.append("Email", document.getElementById('Email').value || "");
        formData.append("Address", document.getElementById('Address').value || "");
        formData.append("Nid", document.getElementById('Nid').value || "");
        formData.append("ActiveStatus", document.getElementById('ActiveStatus').checked ? "Y" : "N");
        formData.append("IsOwnCompanyCustomer", document.getElementById('IsOwnCompanyCustomer').checked);
        formData.append("CustomerGroupId", document.getElementById('CustomerGroupId').value);

        let endpoint = "";
        let method = "";

        if (isEditState) {
            endpoint = '/api/Customer/UpdateCustomer';
            method = "PUT";
            formData.append("CustomerId", document.getElementById('CustomerId').value);
            formData.append("Code", document.getElementById('CustomerCode').value);
            formData.append("Picture", document.getElementById('PicturePath').value || "");

            if (fileInput.files.length > 0) {
                formData.append("ProductImage", fileInput.files[0]);
            }
        } else {
            endpoint = '/api/Customer/CreateCustomer';
            method = "POST";
            formData.append("OpeningBalance", document.getElementById('OpeningBalance').value || "0");
            formData.append("CombineWithSupplier", document.getElementById('CombineWithSupplier').checked);

            if (fileInput.files.length > 0) {
                formData.append("CustomerImage", fileInput.files[0]);
            }
        }

        try {
            const response = await fetch(getApiUrl(endpoint), {
                method: method,
                headers: getAuthHeaders(null),
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                toastr.success(isEditState ? "Customer updated successfully!" : "Customer created successfully!");
                $("#CustomerCode").val(data.data);
                fetchCustomerList();
            } else {
                const errorData = await response.json().catch(() => null);
                console.error("Backend Error:", errorData);
                toastr.error("Operation failed. Please verify input fields.");
            }
        } catch (err) {
            toastr.error("Server error occurred while saving.");
        }
    }

    function fetchCustomerList() {
        const searchVal = ($("#searchInput").val() || "").trim();
        $.ajax({
            url: getApiUrl("/api/SearchingByDapper/GetCustomerByPaginationRequest"),
            type: "GET",
            headers: getAuthHeaders('application/json'),
            data: {
                Page: currentPage || 1,
                PageSize: pageSize || 10,
                Search: searchVal
            },
            success: function (res) {
                BindCustomerTable(res.data);
                console.log('res.datares.datares.datares.data');
                console.log(res.data);
                // console.log();
                totalPages = res.totalPages || 0;
                if (typeof CreatePagination === "function") {
                    CreatePagination();
                }

                if ($("#paginationInfo").length && res.totalRecords !== undefined) {
                    $("#paginationInfo").html(
                        `Showing ${((currentPage - 1) * pageSize) + 1}
                         -
                         ${Math.min(currentPage * pageSize, res.totalRecords)}
                         of
                         ${res.totalRecords}
                         Customers`
                    );
                }
            },
            error: function (xhr, status, error) {
                console.error("API Call Failed:", error);
                if (typeof toastr !== "undefined") {
                    toastr.error("Failed to load customer list.");
                }
            }
        });
    }

    function BindCustomerTable(data) {
        const $tbody = $("#customerListBody");
        $tbody.empty();

        if (!data || data.length === 0) {
            $tbody.html(`<tr><td colspan="9" class="text-center py-3 text-muted">No customers found</td></tr>`);
            return;
        }

        $.each(data, function (index, item) {
            const imgPath = item.picture ? `${API_HOST}/${item.picture}` : DEFAULT_NO_IMAGE;
            const statusBadge = item.activeStatus === 'Y'
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5" style="font-size:0.7rem;">Active</span>'
                : '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5" style="font-size:0.7rem;">Inactive</span>';

            const $tr = $(`
                <tr>
                    <td class="fw-semibold">${((currentPage - 1) * pageSize) + (index + 1)}</td>
                    <td>
                        <img src="${imgPath}"
                             width="32"
                             height="32"
                             class="rounded border"
                             style="object-fit: cover;"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='${DEFAULT_NO_IMAGE}'">
                    </td>
                    <td class="fw-semibold text-dark">${item.customerName || '-'}</td>
                    <td><span class="badge bg-light text-dark border" style="font-size: 0.725rem;">${item.customerCode || 'N/A'}</span></td>
                    <td>${item.phone || '-'}</td>
                    <td>${item.customerGroupName || '-'}</td>
                    <td>${item.address || '-'}</td>
                    <td>${statusBadge}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-action-edit btn-edit-customer">
                            <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                        </button>
                    </td>
                </tr>
            `);

            // Attach object directly to element data store
            $tr.find('.btn-edit-customer').data('customer', item);
            $tbody.append($tr);
        });
    }

    function editCustomer(item) {
        console.log('itemitemitemitem');
        console.log(item);
        isEditState = true;
        document.getElementById('CustomerId').value = item.customerId || item.id || 0;
        document.getElementById('CustomerName').value = item.customerName || '';
        document.getElementById('CustomerCode').value = item.customerCode || '';
        document.getElementById('Phone').value = item.phone || '';
        document.getElementById('Email').value = item.email || '';
        document.getElementById('Address').value = item.address || '';
        document.getElementById('Nid').value = item.nid || '';
        document.getElementById('ActiveStatus').checked = item.activeStatus === 'Y';
        document.getElementById('IsOwnCompanyCustomer').checked = item.isOwnCompanyCustomer === true;
        document.getElementById('CombineWithSupplier').checked = item.supplierAvailable === "Y";
        document.getElementById('CustomerGroupId').value = item.customerGroupId || '';
        document.getElementById('PicturePath').value = item.picture || ''; 

        document.getElementById('openingBalanceGroup').style.display = 'none';
        document.getElementById('combineSupplierGroup').style.display = 'none';

        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('uploadPlaceholder');

        if (item.picture) {
            preview.src = `${API_HOST}/${item.picture}`;
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
        } else {
            setDefaultImage();
        }

        document.getElementById('formModeBadge').textContent = 'Edit Mode';
        document.getElementById('formModeBadge').className = 'badge bg-warning text-dark fw-semibold px-2 py-1';
        document.getElementById('btnSave').innerHTML = '<i class="fa-solid fa-pen-to-square me-1"></i> Update Customer';



        $("#CombineWithSupplier").prop('disabled',true);
        $("#IsOwnCompanyCustomer").prop('disabled',true); 

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetForm() {
        isEditState = false;
        document.getElementById('customerSetupForm').reset();
        document.getElementById('CustomerId').value = "0";
        document.getElementById('PicturePath').value = "";
        document.getElementById('CustomerCode').value = "";

        document.getElementById('openingBalanceGroup').style.display = 'flex';
        document.getElementById('combineSupplierGroup').style.display = 'flex';

        setDefaultImage();

        document.getElementById('formModeBadge').textContent = 'Create Mode';
        document.getElementById('formModeBadge').className = 'badge bg-white text-dark fw-semibold px-2 py-1';
        document.getElementById('btnSave').innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i> Save Customer';
    }
</script>