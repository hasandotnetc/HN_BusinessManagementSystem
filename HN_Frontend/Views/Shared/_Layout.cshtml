        /* ---------------------------------------------------------
                           4. MAIN CONTENT WRAPPER & TOGGLE RULES
                           --------------------------------------------------------- */
        .app-main-wrapper {
            margin-left: var(--sidebar-width);
            margin-top: var(--topbar-height);
            padding: 1.5rem;
            min-height: calc(100vh - var(--topbar-height));
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* 🟢 Collapsed State Rules (Desktop) */
        body.sidebar-collapsed .app-sidebar {
            transform: translateX(-100%);
        }

        body.sidebar-collapsed .app-topbar {
            left: 0;
        }

        body.sidebar-collapsed .app-main-wrapper {
            margin-left: 0;
        }

        /* Mobile Backdrop Overlay */
        .sidebar-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(2px);
            z-index: 1035;
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        /* ---------------------------------------------------------
                           5. RESPONSIVE BREAKPOINTS (Mobile & Tablet)
                           --------------------------------------------------------- */
        @@media (max-width: 767.98px) {
            .app-sidebar {
                transform: translateX(-100%);
            }

            .app-topbar {
                left: 0;
                padding: 0 0.8rem;
            }

            .app-main-wrapper {
                margin-left: 0;
                padding: 1rem 0.8rem;
            }
            /* Show sidebar when mobile-open is toggled */
            body.mobile-sidebar-open .app-sidebar {
                transform: translateX(0);
            }

            body.mobile-sidebar-open .sidebar-backdrop {
                display: block;
                opacity: 1;
            }

            .user-info-text,
            .header-vertical-divider,
            .company-info-card {
                display: none !important; /* Hide details on small mobile devices to prevent overflow */
            }

            .topbar-page-title {
                font-size: 0.92rem;
            }
        }
    </style>
</head>
<body>

    <!-- Smooth Page Loader -->
    <div id="page-loader">
        <div class="loader-spinner"></div>
        <div class="mt-2 text-muted fw-bold" style="font-size: 0.82rem;">Loading Workspace...</div>
    </div>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- LEFT SIDEBAR NAVIGATION -->
    <aside class="app-sidebar" id="appSidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-circle-nodes"></i>
            <span>HN_System</span>
        </a>

        <div class="sidebar-menu">
            <div class="menu-category-title">Main Navigation</div>

            <!-- 1. Dashboard -->
            <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                <span><i class="fa-solid fa-chart-pie link-icon"></i> Dashboard</span>
            </a>

            <!-- 2. Product -->
            <a class="sidebar-link collapsed" data-bs-toggle="collapse" href="#productSubMenu" role="button" aria-expanded="false">
                <span><i class="fa-solid fa-box-open link-icon"></i> Product</span>
                <i class="fa-solid fa-chevron-right fs-7" style="font-size: 0.7rem;"></i>
            </a>
            <div class="collapse submenu" id="productSubMenu">
                <a class="submenu-link" asp-controller="Product" asp-action="Index"><i class="fa-solid fa-list me-1"></i> Products</a>
                <a class="submenu-link" asp-controller="Product" asp-action="ProductGroup"><i class="fa-solid fa-layer-group me-1"></i> Product Group</a>
                <a class="submenu-link" asp-controller="Product" asp-action="Brand"><i class="fa-solid fa-copyright me-1"></i> Brand</a>
                <a class="submenu-link" asp-controller="Product" asp-action="Category"><i class="fa-solid fa-tags me-1"></i> Category</a>
                <a class="submenu-link" asp-controller="Product" asp-action="Price"><i class="fa-solid fa-tag me-1"></i> Price Management</a>
                <a class="submenu-link" asp-controller="Product" asp-action="Discount"><i class="fa-solid fa-percent me-1"></i> Discount</a>
                <a class="submenu-link" asp-controller="ProductUnitTypeConversion" asp-action="Index"><i class="fa-solid fa-percent me-1"></i> Unit Conversion</a>
            </div>

            <!-- 3. Customer -->
            <a class="sidebar-link collapsed" data-bs-toggle="collapse" href="#customerSubMenu" role="button" aria-expanded="false">
                <span><i class="fa-solid fa-users link-icon"></i> Customer</span>
                <i class="fa-solid fa-chevron-right fs-7" style="font-size: 0.7rem;"></i>
            </a>
            <div class="collapse submenu" id="customerSubMenu">
                <a class="submenu-link" asp-controller="Customer" asp-action="Index"><i class="fa-solid fa-user-group me-1"></i> Customer List</a>
                <a class="submenu-link" asp-controller="Customer" asp-action="CustomerGroup"><i class="fa-solid fa-users-rectangle me-1"></i> Category</a>
            </div>

            <!-- 4. Purchase -->
            <a class="sidebar-link collapsed" data-bs-toggle="collapse" href="#purchaseSubMenu" role="button" aria-expanded="false">
                <span><i class="fa-solid fa-cart-shopping link-icon"></i> Purchase</span>
                <i class="fa-solid fa-chevron-right fs-7" style="font-size: 0.7rem;"></i>
            </a>
            <div class="collapse submenu" id="purchaseSubMenu">
                <a class="submenu-link" asp-controller="Purchase" asp-action="Index"><i class="fa-solid fa-file-invoice me-1"></i> Purchase Orders</a>
                <a class="submenu-link" asp-controller="Purchase" asp-action="Supplier"><i class="fa-solid fa-truck-field me-1"></i> Suppliers</a>
            </div>

            <!-- 5. Collection -->
            <a class="sidebar-link collapsed" data-bs-toggle="collapse" href="#collectionSubMenu" role="button" aria-expanded="false">
                <span><i class="fa-solid fa-hand-holding-dollar link-icon"></i> Collection</span>
                <i class="fa-solid fa-chevron-right fs-7" style="font-size: 0.7rem;"></i>
            </a>
            <div class="collapse submenu" id="collectionSubMenu">
                <a class="submenu-link" asp-controller="Collection" asp-action="Index"><i class="fa-solid fa-receipt me-1"></i> Collections</a>
            </div>

            <!-- 6. Point Of Sales (POS) -->
            <a class="sidebar-link" asp-controller="POS" asp-action="Index">
                <span><i class="fa-solid fa-cash-register link-icon"></i> POS System</span>
            </a>

            <!-- 7. Sales Return -->
            <a class="sidebar-link" asp-controller="SalesReturn" asp-action="Index">
                <span><i class="fa-solid fa-arrow-rotate-left link-icon"></i> Sales Return</span>
            </a>

            <div class="menu-category-title">Analytics</div>

            <!-- 8. Reports -->
            <a class="sidebar-link collapsed" data-bs-toggle="collapse" href="#reportSubMenu" role="button" aria-expanded="false">
                <span><i class="fa-solid fa-file-invoice-dollar link-icon"></i> Reports</span>
                <i class="fa-solid fa-chevron-right fs-7" style="font-size: 0.7rem;"></i>
            </a>
            <div class="collapse submenu" id="reportSubMenu">
                <a class="submenu-link" asp-controller="Reports" asp-action="SalesReport"><i class="fa-solid fa-chart-line me-1"></i> Sales Report</a>
                <a class="submenu-link" asp-controller="Reports" asp-action="StockReport"><i class="fa-solid fa-boxes-stacked me-1"></i> Stock Report</a>
            </div>
        </div>
    </aside> 

    <!-- TOPBAR NAVIGATION HEADER -->
    <header class="app-topbar">
        <!-- Left Section: Toggle Button & Page Title -->
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-sidebar-toggle" id="sidebarToggle" title="Toggle Sidebar">
                <i class="fa-solid fa-bars"></i>
            </button>

            <h5 class="topbar-page-title">
                <i class="fa-solid fa-grip-vertical text-muted fs-6"></i>
                <span>@ViewData["Title"]</span>
            </h5>
        </div>

        <!-- Right Section: Company Info, User Profile & Logout -->
        <div class="d-flex align-items-center gap-2">

            <!-- Company & Location Badge Card -->
            <div class="company-info-card" id="companyLocationBox" style="display: none;">
                <img id="headerCompanyLogo" src="/images/default-company.png" class="company-logo-img" alt="Logo" />
                <div>
                    <h6 class="company-name-text" id="headerCompanyName">Company Name</h6>
                    <div class="location-badge">
                        <i class="fa-solid fa-location-dot"></i>
                        <span id="headerLocationName">Location Name</span>
                    </div>
                </div>
            </div>

            <!-- Vertical Separator Divider -->
            <div class="header-vertical-divider"></div>

            <!-- User Profile Info Box -->
            <div class="user-profile-box">
                <div class="user-info-text">
                    <span class="user-name" id="headerUserName">Loading...</span>
                    <div><span class="user-level-badge" id="headerUserLevel">User</span></div>
                </div>
                <img id="headerUserPicture" src="https://ui-avatars.com/api/?name=User&background=663399&color=fff" class="user-avatar-img" alt="User Avatar" />
            </div>

            <!-- Redesigned Logout Button -->
            <a href="javascript:void(0)" onclick="handleLogout()" class="btn-logout-icon ms-1" title="Logout Account">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>

        </div>
    </header>

    <!-- GLOBAL MAIN CONTENT AREA -->
    <div class="app-main-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts Integration Section -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const API_BASE_URL = "https://localhost:7008/api";
        const IMAGE_BASE_URL = "https://localhost:7008/";
        const DEFAULT_IMAGE = `${IMAGE_BASE_URL}Upload/Product/no-image.png`;

        $(document).ready(function () {
            // Dismiss page loader animation smoothly
            setTimeout(function () {
                $('#page-loader').css({ opacity: 0, visibility: 'hidden' });
            }, 250);

            // -----------------------------------------------------------
            // 🟢 SIDEBAR TOGGLE & RESPONSIVE LOGIC
            // -----------------------------------------------------------
            // ১. ডেস্কটপের জন্য আগের সেভ করা পছন্দ (Preference) লোড করা
            if ($(window).width() >= 768) {
                if (localStorage.getItem("sidebar_collapsed") === "true") {
                    $('body').addClass('sidebar-collapsed');
                }
            }

            // ২. Toggle Button Click Event
            $('#sidebarToggle').on('click', function () {
                if ($(window).width() < 768) {
                    // Mobile View: Open/Close Drawer Overlay
                    $('body').toggleClass('mobile-sidebar-open');
                } else {
                    // Desktop View: Toggle Collapse Full Width Mode
                    $('body').toggleClass('sidebar-collapsed');
                    const isCollapsed = $('body').hasClass('sidebar-collapsed');
                    localStorage.setItem("sidebar_collapsed", isCollapsed);
                }
            });

            // ৩. Mobile Backdrop-এ ক্লিক করলে সাইডবার হাইড হয়ে যাবে
            $('#sidebarBackdrop').on('click', function () {
                $('body').removeClass('mobile-sidebar-open');
            });

            // Fetch User & Company Header Data via API
            loadUserProfileDashboardData();

            // Highlight Active Link
            highlightActiveMenu();
        });

        // -----------------------------------------------------------
        // FETCH USER PROFILE & COMPANY DASHBOARD API DATA
        // -----------------------------------------------------------
        function loadUserProfileDashboardData() {
            const token = getAuthCookie("HN_JWT");
            $.ajax({
                url: `${API_BASE_URL}/UserAuthenticationAndLogin/GetMyProfileDashboardByUserId`,
                type: 'GET',
                headers: {
                    'Authorization': token ? `Bearer ${token}` : ''
                },
                success: function (response) {
                    if (response) {
                        const data = response.data || response;

                        // Set User Details
                        $('#headerUserName').text(data.userName || "User");
                        $('#headerUserLevel').text(data.userLevel || "Staff");

                        // User Image
                        if (data.userPicture) {
                            const userImageUrl = `${IMAGE_BASE_URL}${data.userPicture}`;
                            $('#headerUserPicture').attr('src', userImageUrl);
                        } else {
                            $('#headerUserPicture').attr(
                                'src',
                                `https://ui-avatars.com/api/?name=${encodeURIComponent(data.userName || 'User')}&background=663399&color=fff`
                            );
                        }

                        // Set Company & Location Details
                        if (data.companyName) {
                            $('#headerCompanyName').text(data.companyName);
                            $('#headerLocationName').text(data.locationName || 'Main Branch');

                            if (data.companyLogo) {
                                $('#headerCompanyLogo').attr(
                                    'src',
                                    `${IMAGE_BASE_URL}${data.companyLogo}`
                                );
                            }
                            $('#companyLocationBox').fadeIn(200);
                        }
                    }
                },
                error: function (xhr) {
                    console.log("Header Profile API Fetch Error Status:", xhr.status);
                    if (xhr.status === 401) {
                        handleLogout(); // Token Expired, Force Logout
                    }
                }
            });
        }

        function highlightActiveMenu() {
            var currentUrl = window.location.pathname.toLowerCase();
            $('.sidebar-menu a').each(function () {
                var menuUrl = $(this).attr('href')?.toLowerCase();
                if (menuUrl && currentUrl === menuUrl) {
                    $(this).addClass('active');
                    var parentSubmenu = $(this).closest('.submenu');
                    if (parentSubmenu.length) {
                        parentSubmenu.addClass('show');
                        parentSubmenu.prev('.sidebar-link').removeClass('collapsed').attr('aria-expanded', 'true');
                    }
                }
            });
        }

        // -----------------------------------------------------------
        // LOGOUT FUNCTION
        // -----------------------------------------------------------
        function handleLogout() {
            const token = getAuthCookie("HN_JWT");
            $.ajax({
                url: `${API_BASE_URL}/UserAuthenticationAndLogin/logout`,
                type: 'POST',
                headers: {
                    'Authorization': token ? `Bearer ${token}` : ''
                },
                success: function (response) {
                    document.cookie = "HN_JWT=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                    toastr.success("System Logout for you!");
                    setTimeout(function () {
                        window.location.href = '/Account/Login';
                    }, 500);
                },
                error: function (xhr, status, error) {
                    alert('failed');
                    console.error("Logout API error");
                    console.error("Status:", xhr.status);
                    console.error("Error:", error);
                    console.error("Response:", xhr.responseText);
                }
            });
        }
    </script>
</body>
</html>